<!-- Scroll To Top Button -->
<button
  id="scroll-to-top"
  class="scroll-to-top"
  type="button"
  aria-label="Scroll to top"
>
  {% render 'icon', name: 'chevron-down' %}
</button>

<style>
  .scroll-to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;

    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;
    border: 0;
    border-radius: 50%;

    background: var(--color-primary);
    color: #fff;

    cursor: pointer;
    z-index: 999;

    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);

    transition:
      opacity 0.25s ease,
      visibility 0.25s ease,
      transform 0.25s ease,
      background-color 0.2s ease;
  }

  .scroll-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .scroll-to-top:hover {
    background: #222;
  }

  .scroll-to-top:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .scroll-to-top svg {
    display: block;
    width: 24px;
    height: 24px;
    transform: rotate(180deg);
  }

  @media screen and (max-width: 749px) {
    .scroll-to-top {
      right: 16px;
      bottom: 16px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const scrollTopButton = document.getElementById('scroll-to-top');

    /*
      Works with common Shopify footer structures:
      - #shopify-section-footer
      - .shopify-section-group-footer-group
      - footer
    */
    const footer =
      document.querySelector('#shopify-section-footer') ||
      document.querySelector('.shopify-section-group-footer-group') ||
      document.querySelector('footer');

    if (!scrollTopButton || !footer) return;

    const footerObserver = new IntersectionObserver(
      function (entries) {
        const entry = entries[0];

        if (entry.isIntersecting) {
          scrollTopButton.classList.add('is-visible');
        } else {
          scrollTopButton.classList.remove('is-visible');
        }
      },
      {
        threshold: 0.01
      }
    );

    footerObserver.observe(footer);

    scrollTopButton.addEventListener('click', function () {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  });
</script>