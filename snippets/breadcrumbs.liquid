{%- comment -%}
  Breadcrumb trail for a product page: Home / Collection / Product.
  The collection is the one the shopper came from (the `collection` object, set
  when the product URL is /collections/x/products/y), otherwise the product's
  first collection. The "all" and "frontpage" system collections are skipped.
  Also outputs BreadcrumbList structured data for search engines.

  Accepts:
    product - {Object} the product

  Usage:
  {% render 'breadcrumbs', product: product %}
{%- endcomment -%}

{%- liquid
  assign crumb_collection = collection
  if crumb_collection == blank
    assign crumb_collection = product.collections | first
  endif
  if crumb_collection.handle == 'all' or crumb_collection.handle == 'frontpage'
    assign crumb_collection = nil
  endif
-%}

<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumb.label' | t }}">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item"><a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a></li>
    {%- if crumb_collection != blank -%}
      <li class="breadcrumbs__item"><a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a></li>
    {%- endif -%}
    <li class="breadcrumbs__item" aria-current="page">{{ product.title | escape }}</li>
  </ol>
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.navigation.home' | t | json }},
        "item": {{ shop.url | append: routes.root_url | json }}
      }
      {%- if crumb_collection != blank -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ crumb_collection.title | json }},
        "item": {{ shop.url | append: crumb_collection.url | json }}
      }
      {%- endif -%}
      ,{
        "@type": "ListItem",
        "position": {% if crumb_collection != blank %}3{% else %}2{% endif %},
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
    ]
  }
</script>
