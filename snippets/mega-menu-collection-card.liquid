{% doc %}
  Compact collection card used inside the desktop mega-menu dropdown.

  Mirrors mega-menu-product-card.liquid's layout (image + one-line title) but
  sources its image from the collection itself, since a mega-menu
  "collection_link" item has no product to pull an image from.

  @param {collection} collection - The collection to render

  @example
  {% render 'mega-menu-collection-card', collection: sub.object %}
{% enddoc %}

<a href="{{ collection.url }}" class="mega-menu-card">
  <span class="mega-menu-card__media">
    {%- assign first_product = collection.products.first -%}
    {%- if first_product and first_product.featured_image -%}
      {{
        first_product.featured_image
        | image_url: width: 400
        | image_tag:
          loading: 'lazy',
          widths: '200, 300, 400',
          sizes: '200px',
          width: 200,
          height: 200,
          alt: first_product.title
      }}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag }}
    {%- endif -%}
  </span>
  <span class="mega-menu-card__title">{{ collection.title }}</span>
</a>
