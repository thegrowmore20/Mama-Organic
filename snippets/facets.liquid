{%- comment -%}
  Renders the filter sidebar body:
    1. Active filter pills (only when something is actually applied)
    2. Section blocks, in the order set in the theme editor:
       - Quick link (fake accordion, chevron right, non-expanding)
       - Navigation filter menu (up to 3 levels: accordion groups, checkboxes that navigate)
    3. Real Search & Discovery filters (chevron down, actual facets)

  Accepts:
    results         - collection or search object (.filters, .url, .sort_by)
    has_quick_links - boolean, search results only (the old per-section quick link settings)
    section         - the parent section. On the collection page its blocks (quick_link and
                      nav_menu) render here in block order, so merchants can mix and reorder them.
{%- endcomment -%}

{%- liquid
  assign has_active_filters = false
  for filter in results.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank
        assign has_active_filters = true
      endif
      if filter.max_value.value != blank
        assign has_active_filters = true
      endif
    elsif filter.active_values.size > 0
      assign has_active_filters = true
    endif
  endfor
-%}

<facet-filters-form>
  {%- comment -%} sort_by is supplied by the toolbar's <select form="FacetFiltersForm-{{ section.id }}">, not a hidden input here, to avoid a duplicate/conflicting field. {%- endcomment -%}
  <form id="FacetFiltersForm-{{ section.id }}" class="facets" data-section-id="{{ section.id }}">

    {%- comment -%} 1. Active filter pills — only rendered when at least one filter is applied {%- endcomment -%}
    {%- if has_active_filters -%}
      <div class="active-filters" id="ActiveFilters-{{ section.id }}">
        <div class="active-filters__pills">
          {%- for filter in results.filters -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                <span
                  class="active-filters__pill active-filters__pill--price"
                  data-price-pill
                  data-min-name="{{ filter.min_value.param_name }}"
                  data-max-name="{{ filter.max_value.param_name }}"
                >
                  {{ filter.min_value.value | default: 0 | money }}&ndash;{{ filter.max_value.value | default: filter.range_max | money }}
                  <button type="button" class="active-filters__remove" aria-label="{{ 'collections.general.remove' | t }}">{% render 'icon', name: 'close' %}</button>
                </span>
              {%- endif -%}
            {%- else -%}
              {%- for value in filter.active_values -%}
                <a href="{{ value.url_to_remove }}" class="active-filters__pill">
                  {{ value.label | escape }}
                  <span class="active-filters__remove-icon" aria-hidden="true">{% render 'icon', name: 'close' %}</span>
                </a>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <a href="{{ results.url }}" class="active-filters__clear-all body-text">
          {{ 'collections.general.clear_all' | t }}
        </a>
      </div>
    {%- endif -%}

    {%- comment -%} 2. Section blocks, in editor order {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'quick_link' -%}
          {%- if block.settings.text != blank and block.settings.url != blank -%}
            {% render 'facets-quick-link', link_text: block.settings.text, link_url: block.settings.url, attributes: block.shopify_attributes %}
          {%- endif -%}

        {%- when 'nav_menu' -%}
          {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
            {% render 'facets-nav-menu', menu: block.settings.menu, block: block %}
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}

    {%- comment -%} Search results: the section has no blocks, so it keeps its own quick link settings. {%- endcomment -%}
    {%- if has_quick_links -%}
      {%- for link_index in (1..4) -%}
        {%- assign link_text_key = 'quick_link_' | append: link_index | append: '_text' -%}
        {%- assign link_url_key = 'quick_link_' | append: link_index | append: '_url' -%}
        {%- assign link_text = section.settings[link_text_key] -%}
        {%- assign link_url = section.settings[link_url_key] -%}
        {%- if link_text != blank and link_url != blank -%}
          {% render 'facets-quick-link', link_text: link_text, link_url: link_url %}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} 3. Real Search & Discovery filters {%- endcomment -%}
    {%- for filter in results.filters -%}
      {%- if filter.type == 'price_range' -%}
        <details class="facets__group" data-filter-param="{{ filter.param_name }}" open>
          <summary class="facets__summary">
            <span>{{ filter.label | escape }}</span>
            <span class="facets__chevron facets__chevron--down" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
          </summary>
          <div class="facets__body">
            {%- render 'price-range', filter: filter -%}
          </div>
        </details>
      {%- elsif filter.values.size > 0 -%}
        <details class="facets__group" data-filter-param="{{ filter.param_name }}" open>
          <summary class="facets__summary">
            <span>{{ filter.label | escape }}</span>
            <span class="facets__chevron facets__chevron--down" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
          </summary>
          <div class="facets__body">
            <ul class="facets__list" role="list">
              {%- for value in filter.values -%}
                <li class="facets__item{% if value.count == 0 and value.active == false %} facets__item--disabled{% endif %}">
                  <label class="facets__checkbox-label">
                    <input
                      type="checkbox"
                      class="facets__checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    >
                    <span>{{ value.label | escape }}</span>
                    <span class="facets__count text-muted">({{ value.count }})</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </form>
</facet-filters-form>
