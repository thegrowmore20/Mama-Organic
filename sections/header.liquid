}

.predictive-search__group-title {
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin: 0 0 var(--space-3);
}

.predictive-search__group + .predictive-search__group {
