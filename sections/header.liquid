  .header__menu-panel {
    display: grid;
    grid-template-rows: 0fr;
    min-height: 0;
    transition: grid-template-rows 0.3s ease;
  }

  .header__menu-panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .header__menu-panel.is-open {
    grid-template-rows: 1fr;
  }

  .header__accordion-rows {
    display: flex;
    flex-direction: column;
  }

  .header__accordion-row {
    display: flex;
    align-items: center;
    gap: 10px;
