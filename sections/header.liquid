}

.predictive-search__product-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.predictive-search__product-title {
  font-size: 14px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
}

.predictive-search__list li {
  padding-block: 6px;
  font-size: 14px;
}

.predictive-search__list a,
.predictive-search__no-results {
  color: var(--color-primary);
}

.predictive-search__no-results {
  font-size: 14px;
  padding-block: var(--space-3);
}



/* ==========================================================================
   HEADER SEARCH [4/7] - desktop search bar + results panel (990px+)

   Under 990px nothing here applies: the bar is hidden and the search icon
   opens the full-width popup exactly as before.

   990px+:
   - Top row becomes logo | search | icons, with the bar centred and capped
     at --header-search-width.
   - The bar reuses .header__search-field / -input / -submit from the popup.
   - The popup turns into a results-only panel hanging below the header (like
     the mega menu), its results column lined up under the bar. The backdrop
     starts below the header so the bar stays clickable.
   - The popup's own search row is hidden in this mode (the bar is in the header).
   ========================================================================== */

.header-search-desktop {
  display: none;
}

@media screen and (min-width: 990px) {
  .header {
    --header-search-width: 560px;
  }

  /* Side columns never go narrower than the logo / icons themselves (so a
     text logo can't wrap); the bar takes what's left, up to its max width. */
  .header > .header__inner {
    display: grid;
    grid-template-columns:
      minmax(max-content, 1fr)
      minmax(0, var(--header-search-width))
      minmax(max-content, 1fr);
    column-gap: var(--space-6);
  }

  .header > .header__inner > .header__logo {
    justify-self: start;
  }

  .header > .header__inner > .header__icons {
    justify-self: end;
  }

  .header-search-desktop {
    display: block;
    min-width: 0;
    /* HEADER SEARCH [8/8] - containing block for the dropdown below, so it's
       positioned off the bar itself instead of the full-width header. */
    position: relative;
  }

  /* Solid fill so the bar stays readable over a transparent-header hero. */
  .header-search-desktop .header__search-field {
    background: var(--color-background);
    transition: border-color 0.2s ease;
  }

  /* The bar is always on screen, so it needs a visible focus state (the
     popup didn't: opening it was the visible change). */
  .header-search-desktop .header__search-field:focus-within {
    border-color: var(--color-primary);
  }

  /* 42px input + the field's 1px borders = 44px, the height the logo and
     icons already give this row, so the header doesn't grow and nothing
     below it shifts (whatever the theme's line-height). */
  .header-search-desktop .header__search-input {
    height: 42px;
    padding-block: 0;
  }

  .header__icons .header__icon-btn--search {
    display: none;
  }

  .header__search-popup--dropdown {
    /* HEADER SEARCH [8/8] - anchored to .header-search-desktop (reparented
       there in #openDropdown(), restored on close), not to the header. That
       makes "top: 100%" the bar's own bottom edge rather than the bottom of
       the whole header (which includes the nav row below it), and makes the
       inherited left:0/right:0 exactly the bar's width - no separate width
       rule needed. It also means the panel visually covers the nav row
       underneath it, so a cursor moving from the bar straight down into the
       results never actually crosses a nav item and can't trigger its menu. */
    position: absolute;
    top: 100%;
    margin-top: var(--space-2);
    max-height: calc(100vh - var(--header-height, 90px));
    overscroll-behavior: contain;
  }

  .header__search-popup--dropdown .header__search-bar {
    display: none;
  }

  .header__search-popup--dropdown .header__search-popup-inner {
    /* Neutralize the site .container utility's own max-width/padding - the
       panel's parent is already exactly the bar's width, so this padding
       would otherwise inset the results narrower than the bar on both sides. */
    max-width: none;
    /* padding-inline: 0; */
  }

  .header__search-popup--dropdown .header__search-results {
    padding-top: 0;
  }

  .header__search-popup-backdrop--dropdown {
    top: var(--header-height, 90px);
  }
}

/* ==========================================================================
   Mega menu promo images  -  block: "Mega menu – links"

   REPLACES the previous "Mega menu promo images" block at the end of the
   header stylesheet (everything from that banner comment down to the
   closing endstylesheet tag, which stays).

   Desktop layout: .mega-menu__layout is a two-area row.
     [ link columns ................. ][ images ]
   - The columns keep at least 160px each (the theme's own column minimum),
     and wrap only inside their own area.
   - The images take what is left, up to their configured width. When the
     columns need the room the tiles shrink, then the second tile hides, then
     both hide. Links always win; images never drop under the columns.
   ========================================================================== */

.mega-menu__layout {
  --mega-promo-gap: 24px;
  display: flex;
  flex-wrap: nowrap;
  align-items: flex-start;
  gap: var(--space-8);
}

/* Area 1: the link columns. Ideal width = every column at its normal 220px;
   floor = every column at 160px (+1px so sub-pixel rounding can't wrap the
   last column). Never wider than the row, so nothing overflows the panel. */
.mega-menu__layout > .mega-menu__columns {
  flex: 1 1 calc(var(--mega-cols, 1) * 220px + (var(--mega-cols, 1) - 1) * var(--space-8));
  min-width: min(
    100% - var(--space-8),
    calc(var(--mega-cols, 1) * 160px + (var(--mega-cols, 1) - 1) * var(--space-8) + 1px)
  );
}

/* Inside the layout the columns may flex between 160px and their normal
   220px instead of wrapping as soon as 220px no longer fits. */
.mega-menu__layout .mega-menu__column {
  flex: 1 1 160px;
  max-width: 220px;
}

.mega-menu__promos {
  display: flex;
  align-items: flex-start;
  gap: var(--mega-promo-gap, 24px);
}

/* Area 2: the images. A size container, so the tiles can react to the room
   this area actually ended up with (not to the viewport). */
.mega-menu__promos--desktop {
  container: mega-promos / inline-size;
  flex: 0 1 calc(
    var(--mega-promo-count, 2) * var(--mega-promo-width, 240px) +
    (var(--mega-promo-count, 2) - 1) * var(--mega-promo-gap, 24px)
  );
  min-width: 0;
  justify-content: flex-end;
}

.mega-menu__promo {
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex: 1 1 0;
  min-width: 0;
  max-width: var(--mega-promo-width, 240px);
  color: var(--color-primary);
  text-decoration: none;
}

/* Two tiles need 2 x 140px + the 24px gap. Below that, show one. */
@container mega-promos (max-width: 303px) {
  .mega-menu__promo:nth-child(n + 2) {
    display: none;
  }
}

/* Under 140px a tile is too small to be worth showing. */
@container mega-promos (max-width: 139px) {
  .mega-menu__promo {
    display: none;
  }
}

.mega-menu__promo-media {
  display: block;
  width: 100%;
  overflow: hidden;
  border-radius: var(--radius-m);
  background: var(--color-surface);
}

.mega-menu__promo-img {
  display: block;
  width: 100%;
  height: auto;
}

/* Fixed ratios crop the image; "adapt" keeps its natural shape. */
.mega-menu__promos--ratio-square .mega-menu__promo-media { aspect-ratio: 1 / 1; }
.mega-menu__promos--ratio-portrait .mega-menu__promo-media { aspect-ratio: 4 / 5; }
.mega-menu__promos--ratio-landscape .mega-menu__promo-media { aspect-ratio: 3 / 2; }

.mega-menu__promos:not(.mega-menu__promos--ratio-adapt) .mega-menu__promo-img {
  height: 100%;
  object-fit: cover;
}

.mega-menu__promo-subtitle {
  font-size: 14px;
  font-weight: 500;
  font-family: var(--font-accent);
  line-height: 1.35;
}

a.mega-menu__promo:hover .mega-menu__promo-subtitle {
  text-decoration: underline;
  text-underline-offset: 3px;
}

a.mega-menu__promo:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 4px;
}

@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .mega-menu__promo-img {
    transition: transform 0.4s ease;
  }

  a.mega-menu__promo:hover .mega-menu__promo-img {
    transform: scale(1.04);
  }
}

/* Mobile drawer: two tiles side by side under the accordion rows, indented
   to line up with the rows (.header__accordion-row has padding-inline: 1rem). */
.mega-menu__promos--mobile {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  padding: 12px 1rem 16px;
}

.mega-menu__promos--mobile .mega-menu__promo {
  max-width: none;
  gap: 8px;
}

{% endstylesheet %}

{% javascript %}
class MobileNav {
  #toggle
  #nav
  #backdrop
  #closeButton
  #header

  constructor() {
    this.#toggle = document.querySelector('.header__menu-toggle')
    this.#nav = document.querySelector('.header__nav')
    this.#backdrop = document.getElementById('MenuDrawerBackdrop')
    this.#closeButton = document.getElementById('HeaderNavClose')
    this.#header = document.querySelector('.header')
    if (!this.#toggle || !this.#nav) return
    this.#toggle.addEventListener('click', () => this.#onToggle())
    this.#backdrop?.addEventListener('click', () => this.#setOpen(false))
    this.#closeButton?.addEventListener('click', () => this.#setOpen(false))
    document.addEventListener('keydown', (event) => this.#onKeydown(event))
  }

  #onToggle() {
    this.#setOpen(!this.#nav.classList.contains('is-open'))
  }

  #setOpen(open) {
    this.#nav.classList.toggle('is-open', open)
    this.#toggle.setAttribute('aria-expanded', String(open))
    document.body.classList.toggle('menu-drawer-open', open)
    // .header__nav is nested inside .header, whose own z-index caps how high
    // the drawer can stack against siblings like the fixed mobile bottom nav —
    // elevate .header itself while the drawer is open so it escapes that cap.
    this.#header?.classList.toggle('header--drawer-open', open)

    if (this.#backdrop) {
      if (open) {
        this.#backdrop.hidden = false
        requestAnimationFrame(() => this.#backdrop.classList.add('is-open'))
      } else {
        this.#backdrop.classList.remove('is-open')
        window.setTimeout(() => {
          if (!this.#backdrop.classList.contains('is-open')) this.#backdrop.hidden = true
        }, 300)
      }
    }

    if (open) {
      this.#nav.querySelector('a, button')?.focus()
    }
  }

  #onKeydown(event) {
    if (event.key === 'Escape' && this.#nav.classList.contains('is-open')) {
      this.#setOpen(false)
      this.#toggle.focus()
    }
  }
}

class HeaderScroll {
  #header
  #announcementBar
  #lastY = 0
  #ticking = false
  #resizeTimer

  constructor() {
    this.#header = document.querySelector('.header')
    if (!this.#header) return
    this.#announcementBar = document.querySelector('.announcement-bar')

    this.#updatePadding()
    // On a hard refresh the browser can restore scroll position before this
    // ever ran, and #onScroll otherwise only fires from a real scroll event -
    // without this, a reload while already scrolled down left the header
    // visible with none of the --scrolled/--hidden state that scroll
    // position should imply (no background, wrong show/hide state) until
    // the next scroll.
    this.#onScroll()

    window.addEventListener('scroll', () => this.#requestTick(), { passive: true })
    // The header's height changes across breakpoints (nav link padding, logo
    // size), so the compensating body padding — set once above — would go
    // stale on any resize/orientation change without this.
    window.addEventListener('resize', () => this.#onResize(), { passive: true })

    // In the theme editor, adding/removing/reordering a section (e.g. the
    // announcement bar) re-renders in place with no page reload and no
    // resize event - without these, the padding this measured on load would
    // stay stale (leftover space after removing it, none after adding it).
    document.addEventListener('shopify:section:load', () => this.#onEditorChange())
    document.addEventListener('shopify:section:unload', () => this.#onEditorChange())
    document.addEventListener('shopify:section:reorder', () => this.#onEditorChange())
  }

  #onEditorChange() {
    this.#announcementBar = document.querySelector('.announcement-bar')
    this.#updatePadding()
  }

  #updatePadding() {
    const announcementHeight = this.#announcementBar ? this.#announcementBar.offsetHeight : 0
    const totalHeight = this.#header.offsetHeight + announcementHeight

    // --announcement-height offsets .header itself below the announcement bar
    // (0px when there isn't one). --header-height is the *combined* offset -
    // used by body padding below, and by other sections (product page sticky
    // info, the search popup) that just need "how far down does real content
    // start", not the header's height specifically.
    document.documentElement.style.setProperty('--announcement-height', `${announcementHeight}px`)
    document.documentElement.style.setProperty('--header-height', `${totalHeight}px`)

    // A transparent header intentionally overlays hero content, but the
    // announcement bar always has a solid background and isn't meant to - its
    // own height still needs reserving even when the header's doesn't.
    const isTransparent = document.querySelector('.banner--transparent-header') !== null
    document.body.style.paddingTop = `${isTransparent ? announcementHeight : totalHeight}px`
  }

  #onResize() {
    window.clearTimeout(this.#resizeTimer)
    this.#resizeTimer = window.setTimeout(() => this.#updatePadding(), 150)
  }

  #requestTick() {
    if (this.#ticking) return
    this.#ticking = true
    requestAnimationFrame(() => {
      this.#onScroll()
      this.#ticking = false
    })
  }

  #onScroll() {
    const y = window.scrollY
    this.#header.classList.toggle('header--scrolled', y > 10)

    // .header__nav and .header__search-popup are position:fixed but nested
    // inside .header — a transform on .header (from header--hidden) becomes
    // their containing block, dragging the open drawer/popup along with it
    // and breaking their fixed positioning. Never hide the header while
    // either is open.
    // HEADER SEARCH [5/7] - the desktop results panel hangs off the header too.
    const bodyClasses = document.body.classList
    if (bodyClasses.contains('menu-drawer-open') || bodyClasses.contains('search-popup-open') || bodyClasses.contains('search-dropdown-open')) {
      this.#lastY = y
      return
    }

    if (y > 80 && y > this.#lastY) {
      this.#header.classList.add('header--hidden')
    } else {
      this.#header.classList.remove('header--hidden')
    }

    this.#lastY = y
  }
}

class CartToggle {
  constructor() {
    const toggle = document.getElementById('CartToggle')
    if (!toggle) return
    toggle.addEventListener('click', (event) => {
      event.preventDefault()
      document.dispatchEvent(new CustomEvent('cart:open'))
    })
  }
}

class CartIconBubble {
  #bubble

  constructor() {
    this.#bubble = document.getElementById('CartIconBubble')
    if (!this.#bubble) return
    document.addEventListener('cart:updated', (event) => this.#onCartUpdated(event))
  }

  #onCartUpdated(event) {
    const sections = event.detail?.sections
    if (!sections || !sections.header) return
    const doc = new DOMParser().parseFromString(sections.header, 'text/html')
    const updated = doc.getElementById('CartIconBubble')
    if (!updated) return
    this.#bubble.replaceWith(updated)
    this.#bubble = updated
  }
}

// HEADER SEARCH [6/7] - one results panel, two ways in:
// - under 990px: the search icon opens the full-width popup (unchanged behaviour)
// - 990px+: typing in the header bar opens the same panel as a dropdown below the header
// Submitting either form (Enter or the search icon button) goes to the search page as before.
class PredictiveSearch {
  #toggle
  #popup
  #closeButton
  #backdrop
  #popupInput
  #desktopForm
  #desktopInput
  #results
  #header
  #desktopQuery
  #abortController
  #debounceTimer
  #lastFocused
  #mode = null // null | 'popup' | 'dropdown'
  #resultsFor = null // the input whose term the current results belong to
  #refocusing = false // true while we move focus back to the bar ourselves
  #popupHome // HEADER SEARCH [8/8] - the popup's real parent (mobile position)
  #popupHomeNext // ...and the sibling it sat before, to restore its exact spot

  constructor() {
    this.#toggle = document.getElementById('SearchToggle')
    this.#popup = document.getElementById('HeaderSearchPopup')
    this.#closeButton = document.getElementById('HeaderSearchClose')
    this.#backdrop = document.getElementById('SearchPopupBackdrop')
    this.#popupInput = document.getElementById('HeaderSearchInput')
    this.#desktopForm = document.getElementById('HeaderSearchDesktop')
    this.#desktopInput = document.getElementById('HeaderSearchInputDesktop')
    this.#results = document.getElementById('PredictiveSearchResults')
    this.#header = document.querySelector('.header')
    this.#desktopQuery = window.matchMedia('(min-width: 990px)')
    if (!this.#popup || !this.#results) return
    this.#popupHome = this.#popup.parentElement
    this.#popupHomeNext = this.#popup.nextElementSibling

    if (this.#toggle && this.#popupInput) {
      this.#toggle.addEventListener('click', () => this.#openPopup())
      this.#closeButton?.addEventListener('click', () => this.#close())
      this.#popupInput.addEventListener('input', () => this.#onInput(this.#popupInput))
    }
    this.#backdrop?.addEventListener('click', () => this.#close())

    if (this.#desktopInput) {
      this.#desktopInput.addEventListener('input', () => this.#onInput(this.#desktopInput))
      // The results sit at the end of the header in the DOM, so Tab would skip
      // past them to the icons. Tab / Arrow Down from the bar goes into them instead.
      this.#desktopInput.addEventListener('keydown', (event) => {
        if (this.#mode !== 'dropdown') return
        const forward = event.key === 'ArrowDown' || (event.key === 'Tab' && !event.shiftKey)
        const first = this.#resultLinks()[0]
        if (forward && first) {
          event.preventDefault()
          first.focus()
        }
      })
      this.#popup.addEventListener('keydown', (event) => this.#onResultsKeydown(event))
      // Clicking back into the bar brings back the results it already has.
      this.#desktopInput.addEventListener('focus', () => {
        if (this.#refocusing) return
        if (this.#resultsFor === this.#desktopInput && this.#desktopInput.value.trim().length >= 2 && this.#results.innerHTML.trim()) {
          this.#openDropdown()
        }
      })
      // Click or tab anywhere outside the bar and the panel closes it.
      document.addEventListener('click', (event) => this.#onOutside(event.target))
      document.addEventListener('focusin', (event) => this.#onOutside(event.target))
      // Moving on to a mega-menu item means the shopper has left search.
      for (const item of document.querySelectorAll('.header__nav-item.has-menu')) {
        item.addEventListener('mouseenter', () => {
          if (this.#mode === 'dropdown') this.#close({ restoreFocus: false })
        })
      }
    }

    // Crossing 990px with the panel open would leave the wrong presentation on screen.
    this.#desktopQuery.addEventListener('change', () => {
      if (this.#mode) this.#close({ restoreFocus: false })
    })
    document.addEventListener('keydown', (event) => this.#onKeydown(event))
  }

  #openPopup() {
    if (this.#resultsFor !== this.#popupInput) this.#clearResults(this.#popupInput)
    this.#lastFocused = document.activeElement
    this.#mode = 'popup'
    this.#show()
    this.#toggle.setAttribute('aria-expanded', 'true')
    this.#popupInput.focus()
    document.body.classList.add('search-popup-open')
  }

  #openDropdown() {
    if (this.#mode === 'dropdown') return
    this.#mode = 'dropdown'
    this.#popup.classList.add('header__search-popup--dropdown')
    this.#backdrop?.classList.add('header__search-popup-backdrop--dropdown')
    // HEADER SEARCH [8/8] - move the panel into the bar's own wrapper so
    // "position: absolute; top: 100%" (set on .header__search-popup--dropdown)
    // resolves against the bar, not the full-width header. Moved back in
    // #close() below so the mobile popup is unaffected.
    this.#desktopForm?.parentElement?.appendChild(this.#popup)
    this.#show()
    this.#header?.classList.add('header--search-open')
    document.body.classList.add('search-dropdown-open')
  }

  #show() {
    this.#popup.hidden = false
    if (this.#backdrop) this.#backdrop.hidden = false
    // The popup is nested inside .header - if the header was already scrolled
    // hidden (its own transform) before opening, that transform is still the
    // popup's containing block, so it needs clearing here too.
    this.#header?.classList.remove('header--hidden')
    requestAnimationFrame(() => {
      this.#popup.classList.add('is-open')
      this.#backdrop?.classList.add('is-open')
    })
  }

  #close({ restoreFocus = true } = {}) {
    const mode = this.#mode
    if (!mode) return
    this.#mode = null
    window.clearTimeout(this.#debounceTimer)
    this.#abortController?.abort()
    this.#popup.classList.remove('is-open')
    this.#backdrop?.classList.remove('is-open')

    if (mode === 'popup') {
      this.#toggle?.setAttribute('aria-expanded', 'false')
      document.body.classList.remove('search-popup-open')
    } else {
      this.#header?.classList.remove('header--search-open')
      document.body.classList.remove('search-dropdown-open')
    }

    window.setTimeout(() => {
      if (this.#popup.classList.contains('is-open')) return
      this.#popup.hidden = true
      if (this.#backdrop) this.#backdrop.hidden = true
      this.#popup.classList.remove('header__search-popup--dropdown')
      this.#backdrop?.classList.remove('header__search-popup-backdrop--dropdown')
      // HEADER SEARCH [8/8] - put the panel back where it lives for the mobile popup.
      if (mode === 'dropdown' && this.#popupHome) this.#popupHome.insertBefore(this.#popup, this.#popupHomeNext)
    }, 200)

    if (mode === 'popup' && restoreFocus) this.#lastFocused?.focus()
  }

  #onOutside(target) {
    if (this.#mode !== 'dropdown') return
    if (this.#desktopForm?.contains(target) || this.#popup.contains(target)) return
    this.#close({ restoreFocus: false })
  }

  #focusBar() {
    this.#refocusing = true
    this.#desktopInput.focus()
    this.#refocusing = false
  }

  #resultLinks() {
    return Array.from(this.#results.querySelectorAll('a[href]'))
  }

  // Arrow keys move through the results; Arrow Up from the first one, or
  // Shift+Tab from it, goes back to the bar.
  #onResultsKeydown(event) {
    if (this.#mode !== 'dropdown') return
    const links = this.#resultLinks()
    const index = links.indexOf(document.activeElement)
    if (index === -1) return
    if (event.key === 'ArrowDown' && index < links.length - 1) {
      event.preventDefault()
      links[index + 1].focus()
    } else if (event.key === 'ArrowUp' || (event.key === 'Tab' && event.shiftKey && index === 0)) {
      event.preventDefault()
      if (index === 0) this.#focusBar()
      else links[index - 1].focus()
    }
  }

  #onKeydown(event) {
    if (event.key !== 'Escape' || !this.#mode) return
    const mode = this.#mode
    this.#close()
    // Escape from a result link puts the shopper back in the bar (without
    // the bar's focus listener reopening the panel straight away).
    if (mode === 'dropdown' && this.#desktopInput) this.#focusBar()
  }

  #clearResults(owner) {
    this.#abortController?.abort()
    this.#results.innerHTML = ''
    this.#resultsFor = owner
  }

  #onInput(input) {
    window.clearTimeout(this.#debounceTimer)
    if (this.#resultsFor !== input) this.#clearResults(input)
    const term = input.value.trim()
    if (term.length < 2) {
      this.#clearResults(input)
      if (this.#mode === 'dropdown') this.#close({ restoreFocus: false })
      return
    }
    this.#debounceTimer = window.setTimeout(() => this.#search(term, input), 300)
  }

  async #search(term, input) {
    this.#abortController?.abort()
    this.#abortController = new AbortController()

    try {
      const response = await fetch(
        `${window.routes.predictiveSearchUrl}?q=${encodeURIComponent(term)}&resources[type]=product,collection,page,article&resources[limit]=6&section_id=predictive-search`,
        { signal: this.#abortController.signal }
      )
      const text = await response.text()
      const doc = new DOMParser().parseFromString(text, 'text/html')
      const section = doc.getElementById('shopify-section-predictive-search')
      this.#results.innerHTML = section ? section.innerHTML : ''
      this.#resultsFor = input

      // Desktop bar: open the panel once there is something to show, but only
      // if the shopper is still in the bar (not if they clicked away mid-request).
      if (input === this.#desktopInput && this.#desktopQuery.matches) {
        if (this.#results.innerHTML.trim() && document.activeElement === input) {
          this.#openDropdown()
        } else if (!this.#results.innerHTML.trim()) {
          this.#close({ restoreFocus: false })
        }
      }
    } catch (error) {
      if (error.name !== 'AbortError') this.#results.innerHTML = ''
    }
  }
}

// Transparent header only: solid background while a real mouse hovers the
// header. Touch is excluded on purpose - :hover sticks after a tap, which
// would leave the header solid over the hero until the next tap elsewhere.
class HeaderHover {
  constructor() {
    const header = document.querySelector('.header')
    if (!header) return
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')
    header.addEventListener('mouseenter', () => {
      if (finePointer.matches) header.classList.add('header--hovered')
    })
    header.addEventListener('mouseleave', () => header.classList.remove('header--hovered'))
  }
}

class HeaderMenu {
  #items
  #desktopQuery
  #openPanel
  #openTrigger
  #backdrop
  #closeTimer
  #header

  constructor() {
    this.#items = Array.from(document.querySelectorAll('.header__nav-item.has-menu'))
    if (this.#items.length === 0) return
    this.#desktopQuery = window.matchMedia('(min-width: 990px)')
    this.#backdrop = document.getElementById('MegaMenuBackdrop')
    this.#header = document.querySelector('.header')
    this.#backdrop?.addEventListener('click', () => {
      if (this.#openPanel) this.#close(this.#openTrigger, this.#openPanel)
    })

    let firstMenu = null
    for (const item of this.#items) {
      const trigger = item.querySelector('.header__menu-trigger')
      const panel = item.querySelector('.header__menu-panel')
      if (!trigger || !panel) continue
      firstMenu ??= { trigger, panel }

      trigger.addEventListener('click', (event) => {
        if (this.#desktopQuery.matches) return
        event.preventDefault()
        this.#toggle(trigger, panel)
      })
      item.addEventListener('mouseenter', () => {
        if (!this.#desktopQuery.matches) return
        // HEADER SEARCH [7/7] (cont.) - this item's own trigger had no guard
        // against the desktop search dropdown being open, unlike the
        // logo/icons handler below; a cursor straying off the covered area
        // under the search bar onto a nav item would still pop a mega menu.
        if (document.body.classList.contains('search-dropdown-open')) return
        // Cancel any pending close from the item the pointer just left, so
        // switching between two adjacent triggers crossfades straight into
        // the new panel instead of both being briefly closed.
        window.clearTimeout(this.#closeTimer)
        this.#open(trigger, panel)
      })
      item.addEventListener('mouseleave', () => {
        if (!this.#desktopQuery.matches) return
        // The ~4px gap between nav items (.header__nav's gap) means the
        // pointer crosses a dead zone between triggers - closing instantly
        // here left a visible flash where neither panel was open while it
        // travelled that gap. A short delay gives the next item's
        // mouseenter a chance to cancel this before it fires.
        window.clearTimeout(this.#closeTimer)
        this.#closeTimer = window.setTimeout(() => this.#close(trigger, panel), 150)
      })
    }

    // Hovering the logo or the header icons opens the first mega-menu panel
    // too, so the whole header behaves as one hover target. Moving on to a
    // nav item swaps to that item's panel (its mouseenter above), and moving
    // between logo and icons keeps whatever is open (the pending close below
    // is cancelled by the next mouseenter).
    if (firstMenu) {
      for (const area of document.querySelectorAll('.header__logo, .header__icons')) {
        area.addEventListener('mouseenter', () => {
          if (!this.#desktopQuery.matches) return
          // HEADER SEARCH [7/7] - the search bar sits between the logo and the icons;
          // don't drop a mega menu over its results while the shopper is searching.
          if (document.body.classList.contains('search-dropdown-open')) return
          window.clearTimeout(this.#closeTimer)
          if (!this.#openPanel) this.#open(firstMenu.trigger, firstMenu.panel)
        })
        area.addEventListener('mouseleave', () => {
          if (!this.#desktopQuery.matches) return
          window.clearTimeout(this.#closeTimer)
          this.#closeTimer = window.setTimeout(() => {
            if (this.#openPanel) this.#close(this.#openTrigger, this.#openPanel)
          }, 150)
        })
      }
    }

    document.addEventListener('click', (event) => this.#onOutsideClick(event))
    document.addEventListener('keydown', (event) => this.#onKeydown(event))
  }

  #toggle(trigger, panel) {
    const isOpen = trigger.getAttribute('aria-expanded') === 'true'
    if (isOpen) {
      this.#close(trigger, panel)
    } else {
      this.#open(trigger, panel)
    }
  }

  #open(trigger, panel) {
    if (this.#openPanel && this.#openPanel !== panel) {
      // Every panel is absolutely positioned in the same spot below the
      // nav, so animating the outgoing panel's normal fade-out at the same
      // time the incoming one fades in made two different menus' content
      // visibly overlap for ~200ms - it read as a glitch, not a crossfade.
      // Skipping the outgoing panel's transition makes it disappear
      // instantly instead, so only one panel's content is ever on screen.
      const oldPanel = this.#openPanel
      oldPanel.classList.add('header__menu-panel--switching')
      this.#close(this.#openTrigger, oldPanel)
      requestAnimationFrame(() => oldPanel.classList.remove('header__menu-panel--switching'))
    }
    panel.classList.add('is-open')
    trigger.setAttribute('aria-expanded', 'true')
    this.#openPanel = panel
    this.#openTrigger = trigger
    if (this.#desktopQuery.matches) this.#header?.classList.add('header--menu-open')
    if (this.#desktopQuery.matches && this.#backdrop) {
      this.#backdrop.hidden = false
      requestAnimationFrame(() => this.#backdrop.classList.add('is-open'))
    }
  }

  #close(trigger, panel) {
    if (!trigger || !panel) return
    panel.classList.remove('is-open')
    trigger.setAttribute('aria-expanded', 'false')
    if (this.#openPanel === panel) {
      this.#openPanel = null
      this.#openTrigger = null
      this.#header?.classList.remove('header--menu-open')
      if (this.#backdrop) {
        this.#backdrop.classList.remove('is-open')
        window.setTimeout(() => {
          if (!this.#openPanel) this.#backdrop.hidden = true
        }, 200)
      }
    }
  }

  #onOutsideClick(event) {
    if (!this.#desktopQuery.matches || !this.#openPanel) return
    if (this.#openTrigger.closest('.header__nav-item').contains(event.target)) return
    this.#close(this.#openTrigger, this.#openPanel)
  }

  #onKeydown(event) {
    if (event.key !== 'Escape' || !this.#openPanel) return
    const trigger = this.#openTrigger
    this.#close(this.#openTrigger, this.#openPanel)
    trigger?.focus()
  }
}

// This script is already deferred, so the DOM (including every element
// these classes query for) is fully parsed by the time it runs - wrapping
// in DOMContentLoaded was redundant, and worse, pushed init past the entire
// deferred JS bundle finishing (DOMContentLoaded only fires once every
// deferred script across every section has run). HeaderScroll sets
// body's padding-top to compensate for the header's height; that delay
// left <main> briefly rendering un-padded at the top before jumping down
// once this finally ran - a real, measured layout shift (CLS), not just a
// theoretical one.
new MobileNav()
new HeaderScroll()
new CartToggle()
new CartIconBubble()
new PredictiveSearch()
new HeaderMenu()
new HeaderHover()
{% endjavascript %}

