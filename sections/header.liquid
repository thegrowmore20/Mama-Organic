  }

  .header__accordion-row img {
    width: 32px;
    height: 32px;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    flex-shrink: 0;
  }
}

.header__search-popup {
  position: fixed;
  /* Pinned right below the announcement bar only (not --header-height, which
     includes the header) - the header can be scrolled hidden while the popup
     opens, and offsetting for a header that isn't actually there left a gap.
     The popup's own higher z-index already covers the header when visible,
     which is fine since it's a full takeover, not a dropdown beside it. */
  top: var(--announcement-height, 0px);
  left: 0;
  right: 0;
  background: var(--color-background);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  opacity: 0;
  transform: translateY(-16px);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
  max-height: calc(100vh - var(--announcement-height, 0px));
  overflow-y: auto;
  z-index: 40;
}

.header__search-popup.is-open {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.header__search-popup-inner {
  padding-block: var(--space-6) var(--space-8);

  @media screen and (max-width: 992px) {
    padding-block: 1.5rem 2rem;
  }

  @media screen and (max-width: 600px) {
    padding-block: 1rem;
  }
}

.header__search-popup-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 39;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.header__search-popup-backdrop.is-open {
  opacity: 1;
}

.header__search-bar {
  gap: var(--space-3);
}

.header__search-form {
  flex: 1;
  min-width: 0;
}

.header__search-popup-close {
  min-width: 18px;
  min-height: 18px;
  aspect-ratio: 1 / 1;
  background: none;
  border: 1px solid var(--color-primary);
  cursor: pointer;
  color: var(--color-primary);
  border-radius: 50%;
  flex-shrink: 0;
}

@media screen and (max-width: 600px) {
  .header__search-popup-close svg {
    width: 12px;
    height: 12px;
  }
}

.header__search-field {
  gap: var(--space-2);
  flex: 1;
  border: 1px solid var(--color-surface);
  border: 1px solid #cccccc82;
  border-radius: var(--radius-m);
  padding-inline: var(--space-2);
}

.header__search-input {
  flex: 1;
  border: none;
  outline: none;
  padding-block: 14px;
  font-size: 16px;
  font-family: var(--font-body);
  color: var(--color-primary);
  background: transparent;

  @media screen and (max-width: 992px) {
