  }

  .mega-menu-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: 24;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .mega-menu-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .header__accordion-rows {
    display: none;
  }
}

.header__icons {
  color: var(--color-primary);
}

.header__icons a,
.header__icons button {
  background: none;
  border: none;
  padding: 11px;
  margin: 0;
  cursor: pointer;
  color: inherit;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
}

.header__icons > *:first-child {
  margin-left: -11px;
}

.header__icons > *:last-child {
  margin-right: -11px;
}

/* Hovering an icon (search, wishlist, account, cart) tints it the brand teal
   and grows it slightly. The colour goes on the <svg> itself rather than the
   button: the Vensa wishlist app forces its own button colour with
   !important, but the svg draws with currentColor, so setting it there works
   for every icon uniformly. Hover-capable pointers only, so a tap doesn't
   leave an icon stuck enlarged on touch devices. */
/* Search, wishlist, account and cart icons all draw at the same 22px (their
   own width/height attributes differ: 20px for most, 22px for the cart). */
.header__icons svg {
  width: 22px;
  height: 22px;
  transition: transform 0.2s ease, color 0.2s ease;
}

/* The wishlist and cart count badges grow with their icon. They use the
   standalone `scale` property instead of `transform`, so it composes with any
   transform the Vensa app applies to position its own badge. */
.header__icons .vensa-wl-badge,
.header__icons .cart-icon-bubble {
  transition: scale 0.2s ease;
}

@media (hover: hover) and (pointer: fine) {
  .header__icons :is(a, button, shopify-account):hover svg {
    color: var(--color-secondary);
    transform: scale(1.12);
  }

  .header__icons :is(a, button):hover :is(.vensa-wl-badge, .cart-icon-bubble) {
    scale: 1.12;
  }
}

@media (prefers-reduced-motion: reduce) {
  .header__icons svg,
  .header__icons .vensa-wl-badge,
  .header__icons .cart-icon-bubble {
    transition: none;
  }
}

.header__menu-toggle {
  min-width: 44px;
  min-height: 44px;
  padding: 11px;
  margin: -11px;
  background: none;
  border: none;
  cursor: pointer;
  color: inherit;
}

@media screen and (min-width: 990px) {
  .header__menu-toggle {
    display: none;
  }
}

@media screen and (max-width: 989px) {
  .header__account-wrapper {
    display: none;
  }

  .header__icon-btn--wishlist {
