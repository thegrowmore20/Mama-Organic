  /* The Vensa wishlist app forces its header button visible with its own
     !important styles regardless of the display: none above, so it still
     shows up on mobile - tighten its footprint to match the other icons
     instead of leaving it at the larger desktop sizing. */
  .header__icons a,
  .header__icons button {
    padding: 5px;
    min-width: 30px;
    min-height: 30px;
  }

  .header__icons > *:first-child {
    margin-left: -5px;
  }

  .header__icons > *:last-child {
    margin-right: -5px;
  }

  /* The fixed mobile bottom nav (sections/fix-footer-mobile.liquid) has its
     own wishlist icon when configured with one, so the header's copy would
     be a redundant second wishlist icon on screen - the !important is
     needed to beat the Vensa app's own !important visibility override
