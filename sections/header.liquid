  }
}

/* The popup auto-focuses this input on open (see #open() below), which
   would otherwise trigger the global input:focus-visible ring even though
   there's no keyboard navigation happening - the popup opening is already
   the visible state change. */
.header__search-input:focus-visible {
  outline: none;
}

.header__search-submit {
  min-width: 36px;
  min-height: 36px;
