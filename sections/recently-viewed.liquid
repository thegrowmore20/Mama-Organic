{%- comment -%}
  Recently viewed products, shown on product pages below the related products.
  The browser remembers the product handles a shopper has opened (localStorage);
  this section records the current product, then fetches each earlier one as a
  card via the product.card alternate template (templates/product.card.liquid),
  which renders the same shared product-card snippet as every other product
  grid - image, rating, price and Add to Cart. The current product is left
  out, and the section stays hidden until there is something to show.
{%- endcomment -%}

{%- if product != blank -%}
  <recently-viewed
    class="recently-viewed section-padding"
    data-handle="{{ product.handle }}"
    data-limit="{{ section.settings.products_to_show }}"
    style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
    hidden
  >
    <div class="container">
      {% render 'section-header', heading: section.settings.heading %}
      <div class="recently-viewed__grid" data-recently-viewed-grid></div>
    </div>
  </recently-viewed>
{%- endif -%}

{% stylesheet %}
recently-viewed {
  display: block;
}

recently-viewed[hidden] {
  display: none;
}

/* Same centred, wrapping row as the other product grids: 2 per row on phones,
   3 on tablets, 4 on desktop, and a short last row stays centred. */
.recently-viewed__grid {
  --recently-viewed-columns: 2;
  --recently-viewed-gap: var(--space-3);
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--recently-viewed-gap);
}

.recently-viewed__item {
  flex: 0 0 calc((100% - (var(--recently-viewed-columns) - 1) * var(--recently-viewed-gap)) / var(--recently-viewed-columns));
  min-width: 0;
}

@media screen and (min-width: 768px) {
  .recently-viewed__grid {
    --recently-viewed-columns: 3;
    --recently-viewed-gap: var(--space-4);
  }
}

@media screen and (min-width: 1200px) {
  .recently-viewed__grid {
    --recently-viewed-columns: 4;
  }
}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('recently-viewed')) {
  customElements.define('recently-viewed', class RecentlyViewed extends HTMLElement {
    static #storageKey = 'mamaorganic:recently-viewed'
    static #maxStored = 12

    connectedCallback() {
      this.grid = this.querySelector('[data-recently-viewed-grid]')
      if (!this.grid) return
      this.#render()
    }

    #read() {
      try {
        const value = JSON.parse(localStorage.getItem(RecentlyViewed.#storageKey))
        return Array.isArray(value) ? value : []
      } catch {
        return []
      }
    }

    #write(handles) {
      try {
        localStorage.setItem(RecentlyViewed.#storageKey, JSON.stringify(handles))
      } catch {
        // Private mode or blocked storage: the section just stays empty.
      }
    }

    async #render() {
      const current = this.dataset.handle
      const limit = Number(this.dataset.limit) || 4

      // Record this product first (most recent first), then show the others.
      const stored = this.#read().filter((handle) => handle !== current)
      this.#write([current, ...stored].slice(0, RecentlyViewed.#maxStored))

      const handles = stored.slice(0, limit)
      if (handles.length === 0) return

      const cards = await Promise.all(handles.map((handle) => this.#fetchCard(handle)))
      const missing = []
      for (const [index, html] of cards.entries()) {
        if (html === null) {
          missing.push(handles[index])
          continue
        }
        const item = document.createElement('div')
        item.className = 'recently-viewed__item'
        item.innerHTML = html
        this.grid.append(item)
      }

      // Forget products that no longer exist (404).
      if (missing.length > 0) {
        this.#write(this.#read().filter((handle) => !missing.includes(handle)))
      }

      if (this.grid.children.length === 0) return
      this.hidden = false

      // The cards carry Judge.me rating badges - ask it to render the new ones.
      const refreshReviewBadges = () => {
        for (const name of ['batchRenderBadges', 'customizeBadges']) window.jdgm?.[name]?.()
      }
      refreshReviewBadges()
      setTimeout(refreshReviewBadges, 400)
    }

    async #fetchCard(handle) {
      try {
        const response = await fetch(`/products/${encodeURIComponent(handle)}?view=card`)
        if (!response.ok) return null
        return (await response.text()).trim()
      } catch {
        return null
      }
    }
  })
}
{% endjavascript %}

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
