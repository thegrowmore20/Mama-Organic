{%- comment -%}
  Floating WhatsApp chat button, fixed to the bottom-left corner. Opens a
  WhatsApp chat with the number set below. On product pages the message names
  the product and links to it; everywhere else it uses the default message.
  Renders nothing when no number is set.

  On phones it sits above the mobile bottom navigation bar
  (--mobile-bottom-nav-height, set by sections/fix-footer-mobile.liquid).
{%- endcomment -%}

{%- liquid
  assign whatsapp_number = section.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  if section.settings.whatsapp_message == blank
    assign message = 'general.whatsapp.default_message' | t
  else
    assign message = section.settings.whatsapp_message
  endif
  if request.page_type == 'product'
    assign product_url = shop.url | append: product.url
    assign message = 'general.whatsapp.product_message' | t: title: product.title, url: product_url
  endif
-%}

{%- if whatsapp_number != blank -%}
  <div class="whatsapp-widget" style="--whatsapp-size: {{ section.settings.widget_size }}px;">
    <a
      class="whatsapp-widget__link"
      href="https://wa.me/{{ whatsapp_number }}?text={{ message | url_encode }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="{{ 'general.whatsapp.label' | t }} {{ 'general.accessibility.opens_in_new_tab' | t }}"
    >
      <svg class="whatsapp-widget__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 175.216 175.552" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="WhatsAppGradient-{{ section.id }}" x1="85.915" x2="86.535" y1="32.567" y2="137.092" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#57d163"></stop>
            <stop offset="1" stop-color="#23b33a"></stop>
          </linearGradient>
        </defs>
        <path fill="#fff" d="m12.966 161.238 10.439-38.114a73.42 73.42 0 0 1-9.821-36.772c.017-40.556 33.021-73.55 73.578-73.55 19.681.01 38.154 7.669 52.047 21.572s21.537 32.383 21.53 52.037c-.018 40.553-33.027 73.553-73.578 73.553h-.032c-12.313-.005-24.412-3.094-35.159-8.954z"></path>
        <path fill="url(#WhatsAppGradient-{{ section.id }})" d="M87.184 25.227c-33.733 0-61.166 27.423-61.178 61.13a60.98 60.98 0 0 0 9.349 32.535l1.455 2.313-6.179 22.558 23.146-6.069 2.235 1.324c9.387 5.571 20.15 8.517 31.126 8.523h.023c33.707 0 61.14-27.426 61.153-61.135a60.75 60.75 0 0 0-17.895-43.251 60.75 60.75 0 0 0-43.235-17.928z"></path>
        <path fill="#fff" fill-rule="evenodd" d="M68.772 55.603c-1.378-3.061-2.828-3.123-4.137-3.176l-3.524-.043c-1.226 0-3.218.46-4.902 2.3s-6.435 6.287-6.435 15.332 6.588 17.785 7.506 19.013 12.718 20.381 31.405 27.75c15.529 6.124 18.689 4.906 22.061 4.6s10.877-4.447 12.408-8.74 1.532-7.971 1.073-8.74-1.685-1.226-3.525-2.146-10.877-5.367-12.562-5.981-2.91-.919-4.137.921-4.746 5.979-5.819 7.206-2.144 1.381-3.984.462-7.76-2.861-14.784-9.124c-5.465-4.873-9.154-10.891-10.228-12.73s-.114-2.835.808-3.751c.825-.824 1.838-2.147 2.759-3.22s1.224-1.84 1.836-3.065.307-2.301-.153-3.22-4.032-10.011-5.666-13.647"></path>
      </svg>
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
.whatsapp-widget {
  position: fixed;
  bottom: 20px;
  left: 20px;
  z-index: 100;
  width: var(--whatsapp-size, 56px);
  height: var(--whatsapp-size, 56px);
}

.whatsapp-widget__link {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.2));
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.whatsapp-widget__icon {
  display: block;
  width: 100%;
  height: 100%;
}

@media (hover: hover) and (pointer: fine) {
  .whatsapp-widget__link:hover {
    transform: scale(1.08);
  }
}

.whatsapp-widget__link:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 3px;
}

/* Phones: a little closer to the corner, and above the bottom navigation bar. */
@media screen and (max-width: 749px) {
  .whatsapp-widget {
    left: 12px;
    bottom: calc(var(--mobile-bottom-nav-height, 0px) + env(safe-area-inset-bottom, 0px) + 12px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .whatsapp-widget__link {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "WhatsApp widget",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp phone number",
      "default": "+92 311 146 4444",
      "info": "Include the country code. Leave empty to hide the widget."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Default message",
      "info": "The first message of the chat. On product pages it asks about that product instead."
    },
    {
      "type": "range",
      "id": "widget_size",
      "label": "Button size",
      "min": 40,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "WhatsApp widget"
    }
  ]
}
{% endschema %}
