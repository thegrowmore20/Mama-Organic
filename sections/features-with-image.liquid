<section class="features-section section-padding" style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {% render 'section-header', heading: section.settings.heading %}

    {%- assign left_blocks = section.blocks | where: 'type', 'feature' | slice: 0, 2 -%}
    {%- assign right_blocks = section.blocks | where: 'type', 'feature' | slice: 2, 2 -%}

    <div class="u-grid u-items-center features-grid">
      <div class="u-flex u-flex-col features-col">
        {%- for block in left_blocks -%}
          <div class="u-flex feature-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <span class="feature-item__icon">
                {{ block.settings.image | image_url: width: 88 | image_tag: loading: 'lazy', width: 88, height: 88, alt: '' }}
              </span>
            {%- endif -%}
            <div>
              <h3 class="feature-item__title">{{ block.settings.title }}</h3>
              <p class="feature-item__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="u-flex u-justify-center features-media">
        {%- comment -%}
          The picture sits in a rounded frame with a tilted brand-color shape behind it
          (drawn in CSS, so any uploaded image gets it). With no image chosen, a neutral
          placeholder shows in the same frame.
        {%- endcomment -%}
        <div class="features-media__frame">
          {%- if section.settings.image -%}
            {%- assign media_alt = section.settings.image.alt | default: section.settings.heading -%}
            {{ section.settings.image | image_url: width: 876 | image_tag: loading: 'lazy', widths: '350, 500, 700, 876', sizes: '(min-width: 990px) 25vw, 80vw', width: 438, height: 509, alt: media_alt, class: 'features-media__image' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'features-media__image features-media__placeholder' }}
          {%- endif -%}
        </div>
      </div>

      <div class="u-flex u-flex-col features-col">
        {%- for block in right_blocks -%}
          <div class="u-flex feature-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <span class="feature-item__icon">
                {{ block.settings.image | image_url: width: 88 | image_tag: loading: 'lazy', width: 88, height: 88, alt: '' }}
              </span>
            {%- endif -%}
            <div>
              <h3 class="feature-item__title">{{ block.settings.title }}</h3>
              <p class="feature-item__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.features-grid {
  grid-template-columns: 1fr;
  gap: 60px;
  padding: var(--space-6) 0;
}

@media screen and (min-width: 990px) {
  .features-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
  }
}

.features-media__frame {
  position: relative;
  width: min(100%, 360px);
  aspect-ratio: 438 / 509;
}

/* The tilted shape behind the picture. */
.features-media__frame::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--color-secondary);
  border-radius: 16px;
  transform: rotate(-5deg) scale(1.02);
}

.features-media__image {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 16px;
}

.features-media__placeholder {
  background: var(--color-surface);
  fill: var(--color-primary);
  opacity: 0.6;
}

.features-col {
  gap: 36px;
}

/* Icon above the title and text, instead of beside them. */
.feature-item {
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
}

.feature-item__icon {
  width: 50px;
  flex-shrink: 0;
  color: var(--color-secondary);
}

.feature-item__icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.feature-item__title {
  font-size: 19px;
  color: var(--color-primary);
  margin: 0 0 var(--space-2);
  font-weight: 600;
  font-family: var(--font-accent);
}

.feature-item__text {
  font-size: 16px;
  color: var(--color-text);
  line-height: 1.6;
  margin: 0;

  @media screen and (max-width: 600px) {
    line-height: 1.3;
  }
}

/* Side padding on phones keeps the tilted shape and picture off the screen edges. */
.features-media {
  position: relative;
  padding: 0 var(--space-6);
}

@media screen and (min-width: 990px) {
  .features-media {
    padding: 0;
  }
}

@media screen and (max-width: 989px) {
  .features-col:first-of-type {
    order: 0;
  }

  .features-media {
    order: 1;
  }

  .features-col:last-of-type {
    order: 2;
  }
}

.features-media img {
  max-height: 460px;
  object-fit: cover;

  @media screen and (max-width: 1199px) {
    max-height: 350px;
  }

  @media screen and (max-width: 992px) {
    max-height: fit-content;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Features with image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Pakistanis Trust Shivora for Skincare"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Center image",
      "info": "Upload a portrait image (about 438 x 509). It shows in a rounded frame with a tilted brand-color shape behind it."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Organic Ingredients"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Pure, organic, and halal-certified skincare made with nature's finest ingredients. Free from harsh chemicals for gentle, effective care."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features with image",
      "blocks": [
        { "type": "feature", "settings": { "title": "100% Organic Ingredients", "text": "Pure, organic, and halal-certified skincare made with nature's finest ingredients. Free from harsh chemicals for gentle, effective care." } },
        { "type": "feature", "settings": { "title": "Made for Local Skin Needs", "text": "Pure, organic, and halal-certified skincare made with nature's finest ingredients. Free from harsh chemicals for gentle, effective care." } },
        { "type": "feature", "settings": { "title": "Easy to use", "text": "Science-backed skincare combining natural ingredients with proven formulas for effective results." } },
        { "type": "feature", "settings": { "title": "Results You Can See", "text": "Science-backed skincare combining natural ingredients with proven formulas for effective results." } }
      ]
    }
  ]
}
{% endschema %}
