{%- comment -%}
  Icon grid with three looks, chosen by the Style setting:
    cards    - bordered cards with a round icon (default)
    band     - full-width dark green strip, compact icon + title + text (trust bar)
    tiles    - tinted tiles with a large number (left) and icon (right) above the title and text
    panels   - dark green section with white cards: title and text on top, number bottom-left,
               icon in a rounded corner notch bottom-right
    numbered - open list with a large 01, 02... number and a top rule (brand values)
  Hides when it has no blocks.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section
    class="about-icon-grid about-icon-grid--{{ section.settings.style }} section-padding"
    style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --columns: {{ section.settings.columns }};"
  >
    <div class="container">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        text: section.settings.text
      %}

      <ul class="about-icon-grid__list" role="list">
        {%- for block in section.blocks -%}
          <li class="about-icon-grid__item" {{ block.shopify_attributes }}>
            {%- if section.settings.style == 'numbered' or section.settings.style == 'tiles' or section.settings.style == 'panels' -%}
              <span class="about-icon-grid__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
            {%- endif -%}
            {%- if section.settings.style != 'numbered' -%}
              <span class="about-icon-grid__icon" aria-hidden="true">{% render 'icon', name: block.settings.icon %}</span>
            {%- endif -%}
            <div class="about-icon-grid__body">
              {%- if block.settings.title != blank -%}
                <h3 class="about-icon-grid__title h6">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="about-icon-grid__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
.about-icon-grid__list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-5) var(--space-4);
  margin: var(--space-7) 0 0;
  padding: 0;
  list-style: none;
}

.about-icon-grid__list:first-child {
  margin-top: 0;
}

.about-icon-grid__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.about-icon-grid__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  margin-bottom: var(--space-3);
  color: var(--color-secondary-a11y, var(--color-secondary));
  background: var(--color-surface);
  border-radius: 50%;
}

.about-icon-grid__icon svg {
  width: 26px;
  height: 26px;
}

.about-icon-grid__title {
  margin: 0;
  color: var(--color-primary);
}

.about-icon-grid__text {
  margin: var(--space-2) 0 0;
  font-size: 14px;
  line-height: 1.5;
}

/* cards */
.about-icon-grid--cards .about-icon-grid__item,
.about-icon-grid--surface .about-icon-grid__item {
  padding: var(--space-5) var(--space-3);
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-m);
}

.about-icon-grid--surface {
  background: var(--color-surface);
}

/* band */
.about-icon-grid--band {
  background: var(--color-primary);
}

.about-icon-grid--band .about-icon-grid__icon {
  color: var(--color-primary);
  background: var(--color-surface);
}

.about-icon-grid--band .about-icon-grid__title,
.about-icon-grid--band .about-icon-grid__text {
  color: var(--color-background);
}

.about-icon-grid--band .about-icon-grid__text {
  opacity: 0.85;
}

/* numbered */
.about-icon-grid--numbered .about-icon-grid__item {
  align-items: flex-start;
  padding-top: var(--space-4);
  text-align: left;
  border-top: 2px solid var(--color-secondary);
}

.about-icon-grid__number {
  margin-bottom: var(--space-2);
  font-family: var(--font-heading);
  font-size: 40px;
  line-height: 1;
  color: var(--color-secondary-a11y, var(--color-secondary));
}

/* tiles */
.about-icon-grid--tiles .about-icon-grid__list {
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
}

.about-icon-grid--tiles .about-icon-grid__item {
  position: relative;
  align-items: flex-start;
  padding: var(--space-5);
  text-align: left;
  background: var(--color-surface);
  border-radius: var(--radius-m);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.about-icon-grid--tiles .about-icon-grid__item:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

.about-icon-grid--tiles .about-icon-grid__number {
  margin-bottom: var(--space-4);
  font-size: 56px;
}

.about-icon-grid--tiles .about-icon-grid__icon {
  position: absolute;
  top: var(--space-5);
  right: var(--space-5);
  width: 48px;
  height: 48px;
  margin: 0;
  color: var(--color-primary);
  background: var(--color-background);
}

.about-icon-grid--tiles .about-icon-grid__title {
  font-size: 18px;
}

.about-icon-grid--tiles .about-icon-grid__text {
  font-size: 15px;
  line-height: 1.6;
}

/* panels */
.about-icon-grid--panels {
  background: var(--color-primary);
}

.about-icon-grid--panels .section-header__eyebrow {
  color: var(--color-surface);
}

.about-icon-grid--panels .section-header__heading,
.about-icon-grid--panels .section-header__text {
  color: var(--color-background);
}

.about-icon-grid--panels .about-icon-grid__list {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-3);
}

.about-icon-grid--panels .about-icon-grid__item {
  position: relative;
  align-items: flex-start;
  min-height: 200px;
  padding: var(--space-4) var(--space-3) var(--space-3);
  overflow: hidden;
  text-align: left;
  background: var(--color-background);
  border-radius: 20px;
}

.about-icon-grid--panels .about-icon-grid__body {
  max-width: 100%;
}

.about-icon-grid--panels .about-icon-grid__title {
  font-size: 18px;
}

.about-icon-grid--panels .about-icon-grid__number {
  order: 2;
  margin: auto 0 0;
  font-size: 22px;
  opacity: 0.55;
}

.about-icon-grid--panels .about-icon-grid__icon {
  position: absolute;
  right: 0;
  bottom: 0;
  align-items: flex-end;
  justify-content: flex-end;
  box-sizing: border-box;
  width: 64px;
  height: 64px;
  margin: 0;
  padding: var(--space-3);
  color: var(--color-primary);
  background: var(--color-surface);
  border-radius: 64px 0 0;
}

.about-icon-grid--panels .about-icon-grid__icon svg {
  width: 26px;
  height: 26px;
}

@media screen and (prefers-reduced-motion: reduce) {
  .about-icon-grid--tiles .about-icon-grid__item {
    transition: none;
  }

  .about-icon-grid--tiles .about-icon-grid__item:hover {
    transform: none;
  }
}

@media screen and (min-width: 750px) {
  .about-icon-grid--tiles .about-icon-grid__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .about-icon-grid--panels .about-icon-grid__list {
    gap: var(--space-5);
  }

  .about-icon-grid--panels .about-icon-grid__item {
    min-height: 220px;
    padding: var(--space-6) var(--space-5) var(--space-5);
  }

  .about-icon-grid--panels .about-icon-grid__body {
    max-width: 85%;
  }

  .about-icon-grid--panels .about-icon-grid__title {
    font-size: 24px;
  }

  .about-icon-grid--panels .about-icon-grid__number {
    font-size: 28px;
  }

  .about-icon-grid--panels .about-icon-grid__icon {
    width: 96px;
    height: 96px;
    padding: var(--space-4);
    border-radius: 96px 0 0;
  }

  .about-icon-grid--panels .about-icon-grid__icon svg {
    width: 36px;
    height: 36px;
  }

  .about-icon-grid__list {
    grid-template-columns: repeat(min(var(--columns), 3), minmax(0, 1fr));
    gap: var(--space-5);
  }
}

@media screen and (min-width: 990px) {
  .about-icon-grid__list {
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
  }

  .about-icon-grid--numbered .about-icon-grid__list {
    gap: var(--space-6);
  }

  .about-icon-grid--tiles .about-icon-grid__list {
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--space-5);
  }

  .about-icon-grid--panels .about-icon-grid__list {
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "About icon grid",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "cards", "label": "Cards" },
        { "value": "surface", "label": "Cards on tinted background" },
        { "value": "band", "label": "Dark green band" },
        { "value": "tiles", "label": "Numbered tiles with icon" },
        { "value": "panels", "label": "White cards on dark green" },
        { "value": "numbered", "label": "Numbered list" }
      ],
      "default": "cards"
    },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "drop", "label": "Drop" },
            { "value": "shield", "label": "Shield" },
            { "value": "target", "label": "Target" },
            { "value": "check", "label": "Check" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "sun", "label": "Sun" },
            { "value": "package", "label": "Package" },
            { "value": "gift", "label": "Gift" },
            { "value": "percent", "label": "Percent" },
            { "value": "truck", "label": "Truck" },
            { "value": "user", "label": "User" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Natural" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About icon grid",
      "blocks": [
        { "type": "item", "settings": { "icon": "leaf", "title": "100% Natural" } },
        { "type": "item", "settings": { "icon": "shield", "title": "Toxin Free" } },
        { "type": "item", "settings": { "icon": "package", "title": "Affordable Prices" } },
        { "type": "item", "settings": { "icon": "truck", "title": "Doorstep Delivery" } }
      ]
    }
  ]
}
{% endschema %}
