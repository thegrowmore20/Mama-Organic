<div class="cart-drawer-backdrop" id="CartDrawerBackdrop" hidden></div>
<div class="u-flex u-flex-col cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerHeading" aria-hidden="true" hidden inert>
  <div class="u-flex u-items-center u-justify-between cart-drawer__header">
    <h2 class="cart-drawer__heading" id="CartDrawerHeading">{{ 'general.cart.title' | t }}</h2>
    <button type="button" class="u-inline-flex u-items-center u-justify-center cart-drawer__close" id="CartDrawerClose" aria-label="{{ 'general.accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  <div id="CartDrawerContent" class="u-flex u-flex-col cart-drawer__content" data-cart-sections="cart-drawer,header">
    {%- liquid
      assign show_shipping_bar = false
      if settings.show_free_shipping_bar
        assign show_shipping_bar = true
        assign markets_raw = settings.free_shipping_markets | strip
        assign countries_raw = settings.free_shipping_countries | strip
        if markets_raw != blank
          assign show_shipping_bar = false
          assign markets_list = markets_raw | newline_to_br | strip_newlines | split: '<br />'
          for market_handle in markets_list
            assign normalized_handle = market_handle | strip | handleize
            if normalized_handle == localization.market.handle
              assign show_shipping_bar = true
            endif
          endfor
        elsif countries_raw != blank
          assign show_shipping_bar = false
          assign countries_list = countries_raw | newline_to_br | strip_newlines | split: '<br />'
          for country_code in countries_list
            assign normalized_code = country_code | strip | upcase
            if normalized_code == 'UK'
              assign normalized_code = 'GB'
            endif
            if normalized_code == localization.country.iso_code
              assign show_shipping_bar = true
            endif
          endfor
        endif
      endif
    -%}
    {%- if show_shipping_bar and cart.item_count > 0 -%}
      {%- liquid
        assign threshold_cents = settings.free_shipping_threshold | times: 100
        assign remaining_cents = threshold_cents | minus: cart.total_price | at_least: 0
        assign remaining_money = remaining_cents | money
        assign progress_percent = 100
        if threshold_cents > 0
          assign progress_percent = cart.total_price | times: 100.0 | divided_by: threshold_cents | at_most: 100
        endif
      -%}
      <div class="cart-drawer__shipping-bar">
        <p class="cart-drawer__shipping-message">
          {%- if remaining_cents > 0 -%}
            {{ settings.free_shipping_message_before | replace: '[amount]', remaining_money }}
          {%- else -%}
            {{ settings.free_shipping_message_after }}
          {%- endif -%}
        </p>
        <div class="cart-drawer__shipping-track" role="progressbar" aria-valuenow="{{ progress_percent | round }}" aria-valuemin="0" aria-valuemax="100" style="background: {{ settings.free_shipping_bar_track_color }};">
          <div class="cart-drawer__shipping-fill" style="width: {{ progress_percent }}%; background: {{ settings.free_shipping_bar_fill_color }};"></div>
        </div>
      </div>
    {%- endif -%}

    {%- if cart.item_count > 0 -%}
      <ul class="u-flex u-flex-col cart-drawer__items" role="list">
        {%- for item in cart.items -%}
          {%- assign item_alt = item.image.alt | default: item.product.title -%}
          <li class="u-grid cart-drawer__item" data-cart-item data-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-drawer__item-media">
              {{ item.image | image_url: width: 140 | image_tag: loading: 'lazy', widths: '70, 105, 140', width: 70, height: 70, alt: item_alt }}
            </a>
            <div class="cart-drawer__item-body">
              <div class="u-flex u-justify-between cart-drawer__item-title-row">
                <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
                <button type="button" class="u-inline-flex u-items-center u-justify-center cart-drawer__remove" data-cart-remove aria-label="{{ 'general.cart.remove' | t: title: item.product.title }}">
                  {% render 'icon', name: 'trash' %}
                </button>
              </div>
              {%- if item.product.has_only_default_variant == false -%}
                <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
              {%- endif -%}
              {%- if item.line_level_discount_allocations.size > 0 -%}
                <div class="cart-drawer__item-discounts">
                  {%- for discount_allocation in item.line_level_discount_allocations -%}
                    <span class="u-inline-flex u-items-center cart-drawer__discount-badge">
                      {% render 'icon', name: 'tag' %}
                      {{ discount_allocation.discount_application.title }}
                    </span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <div class="u-flex u-items-center u-justify-between cart-drawer__item-bottom-row">
                <div class="u-flex cart-drawer__item-price">
                  <span class="price-item price-item--regular">{{ item.final_line_price | money }}</span>
                  {%- if item.variant.compare_at_price > item.variant.price -%}
                    {%- assign line_compare_at = item.variant.compare_at_price | times: item.quantity -%}
                    <s class="price-item price-item--compare">{{ line_compare_at | money }}</s>
                    <span class="cart-drawer__save-badge">Save {{ line_compare_at | minus: item.final_line_price | money }}</span>
                  {%- endif -%}
                </div>
                <div class="u-flex u-items-center cart-drawer__qty" role="group" aria-label="{{ 'general.cart.quantity' | t }}">
                  <button type="button" class="cart-drawer__qty-btn" data-cart-qty-decrease aria-label="{{ 'general.cart.decrease_quantity' | t }}">&minus;</button>
                  <input type="number" id="CartDrawerQuantity-{{ section.id }}-{{ forloop.index }}" name="updates[]" class="cart-drawer__qty-input" data-cart-qty-input value="{{ item.quantity }}" min="0" step="1" aria-label="{{ 'general.cart.quantity' | t }}: {{ item.product.title | escape }}">
                  <button type="button" class="cart-drawer__qty-btn" data-cart-qty-increase aria-label="{{ 'general.cart.increase_quantity' | t }}">+</button>
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="u-flex u-items-center u-justify-center u-flex-col cart-drawer__empty">
        <p class="cart-drawer__empty-heading">{{ 'general.cart.empty_heading' | t }}</p>
        <a href="{{ settings.cart_empty_button_link | default: routes.all_products_collection_url }}" class="button button--dark">{{ 'general.cart.empty_cta' | t }}</a>
      </div>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    {%- liquid
      comment
        Same calculation as the AirVape cart modal:
        - Total price: every line at its compare-at (original) price when it is
          on sale, otherwise at its price.
        - Discount %: the compare-at saving, plus any line-level and cart-level
          discount (codes) percentages.
        - Discount amount: the compare-at saving plus the discounts applied.
      endcomment
      assign compare_at_total = 0
      assign total_compare_at_savings = 0
      assign c_savings_percent = 0
      assign regular_price_total = 0
      assign discount_total = cart.total_discount

      for item in cart.items
        assign quantity = item.quantity
        assign regular_price = item.variant.price
        assign compare_price = item.variant.compare_at_price
        assign item_total_regular_price = regular_price | times: quantity

        if compare_price and compare_price > regular_price
          assign item_total_compare_price = compare_price | times: quantity
        else
          assign item_total_compare_price = regular_price | times: quantity
        endif

        assign compare_at_total = compare_at_total | plus: item_total_compare_price
        assign regular_price_total = regular_price_total | plus: item_total_regular_price

        if compare_price and compare_price > regular_price
          assign single_item_save = compare_price | minus: regular_price
          assign line_item_save = single_item_save | times: quantity
          assign total_compare_at_savings = total_compare_at_savings | plus: line_item_save
        endif

        assign item_level_discount_percentage = 0
        if item.line_level_discount_allocations.size > 0
          for discount in item.line_level_discount_allocations
            assign item_level_discount_percentage = item_level_discount_percentage | plus: discount.discount_application.value | round
          endfor
        endif
      endfor

      if compare_at_total > 0 and total_compare_at_savings > 0
        assign c_savings_percent = total_compare_at_savings | times: 100.0 | divided_by: compare_at_total | round
      endif

      assign cart_level_discount_percentage = 0
      for discount in cart.cart_level_discount_applications
        assign cart_level_discount_percentage = cart_level_discount_percentage | plus: discount.value | round
      endfor

      assign grand_saving = c_savings_percent | plus: item_level_discount_percentage | plus: cart_level_discount_percentage

      assign total_line_price = compare_at_total | minus: regular_price_total
      assign total_saved_amount = total_line_price | plus: discount_total
    -%}
    <div id="CartDrawerFooter" class="cart-drawer__footer">
      <div class="cart-drawer__summary">
        {%- if total_saved_amount > 0 -%}
          <div class="u-flex u-items-center u-justify-between cart-drawer__summary-row">
            <span>{{ 'general.cart.total_price' | t }}</span>
            <span>{{ compare_at_total | money }}</span>
          </div>
          <div class="u-flex u-items-center u-justify-between cart-drawer__summary-row cart-drawer__summary-row--discount">
            <span class="u-inline-flex u-items-center cart-drawer__summary-label">
              {{ 'general.cart.discount' | t }}
              <span class="u-inline-flex u-items-center cart-drawer__summary-percent">
                {% render 'icon', name: 'tag' %}{{ grand_saving }}%
              </span>
            </span>
            <span>-{{ total_saved_amount | money }}</span>
          </div>
        {%- endif -%}
        <div class="u-flex u-items-center u-justify-between cart-drawer__summary-row cart-drawer__summary-row--total">
          <span>{{ 'general.cart.total' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
      </div>
      <div class="cart-drawer__note" data-cart-note>
        <button
          type="button"
          class="u-flex u-items-center cart-drawer__note-toggle"
          aria-expanded="false"
          aria-controls="CartDrawerNotePanel"
          data-note-toggle
        >
          {% render 'icon', name: 'pencil' %}
          <span data-note-label data-label-add="{{ 'general.cart.add_note' | t }}" data-label-edit="{{ 'general.cart.edit_note' | t }}">
            {%- if cart.note != blank -%}{{ 'general.cart.edit_note' | t }}{%- else -%}{{ 'general.cart.add_note' | t }}{%- endif -%}
          </span>
        </button>
        <div class="cart-drawer__note-panel" id="CartDrawerNotePanel" data-note-panel>
          <div class="cart-drawer__note-inner">
            <label class="visually-hidden" for="CartDrawerNote">{{ 'general.cart.note_label' | t }}</label>
            <textarea
              id="CartDrawerNote"
              class="cart-drawer__note-field"
              name="note"
              rows="3"
              placeholder="{{ 'general.cart.note_placeholder' | t }}"
              data-note-field
            >{{ cart.note }}</textarea>
            <button type="button" class="button button--dark cart-drawer__note-save" data-note-save>
              {{ 'general.cart.save_note' | t }}
            </button>
            <p class="cart-drawer__note-status" role="status" data-note-status
              data-saved="{{ 'general.cart.note_saved' | t }}"
              data-failed="{{ 'general.cart.note_failed' | t }}"></p>
          </div>
        </div>
      </div>
      <a href="/checkout" class="button button--accent cart-drawer__checkout">{{ 'general.cart.checkout' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.cart-drawer-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10010;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.cart-drawer-backdrop.is-open {
  opacity: 1;
}

.cart-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 90%;
  max-width: 400px;
  background: var(--color-background);
  z-index: 10011;
  transform: translateX(100%);
  transition: transform 0.3s ease;
}

.cart-drawer.is-open {
  transform: translateX(0);
}

.cart-drawer__header {
  padding: var(--space-5);
  border-bottom: 1px solid var(--color-surface);
}

.cart-drawer__heading {
  font-size: 20px;
  font-weight: 500;
  font-family: var(--font-subheading);
  margin: 0;
  color: var(--color-primary);
}

.cart-drawer__close {
  min-width: 44px;
  min-height: 44px;
  margin: -11px;
  padding: 11px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-primary);
}

.cart-drawer__content {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-5);
  position: relative;
}

.cart-drawer__content.is-loading {
  pointer-events: none;
}

.cart-drawer__content.is-loading > * {
  opacity: 0.4;
}

.cart-drawer__content.is-loading::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 28px;
  height: 28px;
  margin: -14px 0 0 -14px;
  border: 3px solid var(--color-surface);
  border-top-color: var(--button-primary, var(--color-secondary));
  border-radius: 50%;
  animation: button-spin 0.6s linear infinite;
}

.cart-drawer__shipping-bar {
  margin-bottom: var(--space-5);
}

.cart-drawer__shipping-message {
  font-size: 13px;
  color: var(--color-primary);
  margin: 0 0 10px;
}

.cart-drawer__shipping-track {
  height: 6px;
  border-radius: var(--radius-s);
  overflow: hidden;
}

.cart-drawer__shipping-fill {
  height: 100%;
  border-radius: var(--radius-s);
  transition: width 0.3s ease;
}

.cart-drawer__items {
  gap: var(--space-5);
}

.cart-drawer__item {
  grid-template-columns: 70px minmax(0, 1fr);
  gap: 14px;
}

/* The Vensa wishlist app injects its own heart button into each line item;
   hidden here only (not elsewhere it appears, e.g. product cards/PDP) since
   the drawer is a confirm-and-checkout flow, not a browsing context. */
.cart-drawer__item [class*="vensa-wl"] {
  display: none !important;
}

.cart-drawer__item-media {
  display: block;
  width: 70px;
  height: 70px;
}

.cart-drawer__item-media img {
  display: block;
  width: 70px;
  height: 70px;
  object-fit: cover;
  border-radius: var(--radius-s);
  background: var(--color-surface);
}

.cart-drawer__item-body {
  min-width: 0;
}

.cart-drawer__item-title-row {
  align-items: flex-start;
  gap: var(--space-2);
}

.cart-drawer__item-title {
  font-size: 14px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cart-drawer__item-bottom-row {
  gap: var(--space-3);
  margin-top: var(--space-2);
}

.cart-drawer__item-variant {
  font-size: 12px;
  color: var(--color-text-muted);
  margin: 0 0 var(--space-2);
}

.cart-drawer__item-discounts {
  margin-bottom: var(--space-2);
}

.cart-drawer__discount-badge {
  gap: var(--space-1);
  background: var(--button-primary, var(--color-secondary));
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  font-family: var(--font-accent);
  padding: 3px var(--space-2);
  border-radius: var(--radius-s);
}

.cart-drawer__qty {
  border: 1px solid var(--color-surface);
  border-radius: var(--radius-s);
}

.cart-drawer__qty-btn {
  width: 32px;
  height: 32px;
  min-width: 32px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-primary);
  font-size: 16px;
}

.cart-drawer__qty-input {
  width: 32px;
  border: none;
  text-align: center;
  font-size: 13px;
  color: var(--color-primary);
  -moz-appearance: textfield;
}

.cart-drawer__qty-input::-webkit-outer-spin-button,
.cart-drawer__qty-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.cart-drawer__item-price {
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6px;
  font-size: 14px;
  min-width: 0;
}

.cart-drawer__item-price .price-item {
  overflow: hidden;
  text-overflow: ellipsis;
}

.cart-drawer__save-badge {
  background: var(--button-primary, var(--color-secondary));
  color: #fff;
  font-size: 11px;
  padding: 3px var(--space-2);
  border-radius: var(--radius-s);
}

.cart-drawer__remove {
  min-width: 44px;
  min-height: 44px;
  margin: -11px -11px -11px 0;
  padding: 11px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.cart-drawer__footer {
  flex-shrink: 0;
  padding: var(--space-5);
  border-top: 1px solid var(--color-surface);
}

/* Price summary: total price, discount (only when something is saved), total. */
.cart-drawer__summary {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.cart-drawer__summary-row {
  font-size: 15px;
  font-family: var(--font-subheading);
  font-weight: var(--font-subheading-weight);
  color: var(--color-primary);
}

.cart-drawer__summary-row--discount {
  font-weight: 600;
  color: var(--color-secondary);
}

.cart-drawer__summary-label {
  gap: var(--space-2);
}

.cart-drawer__summary-percent {
  gap: var(--space-1);
  font-size: 13px;
}

.cart-drawer__summary-percent svg {
  width: 14px;
  height: 14px;
}

/* Order note: a row that opens a panel, animated with grid-template-rows
   (0fr to 1fr) so there is no height measuring in script. */
.cart-drawer__note {
  border-top: 1px solid var(--color-border);
  margin-bottom: var(--space-4);
}

.cart-drawer__note-toggle {
  gap: var(--space-2);
  width: 100%;
  padding: var(--space-3) 0;
  border: 0;
  background: none;
  font-size: 14px;
  font-family: var(--font-subheading);
  font-weight: var(--font-subheading-weight);
  color: var(--color-primary);
  cursor: pointer;
  text-align: left;
}

.cart-drawer__note-toggle svg {
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
}

.cart-drawer__note-panel {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.3s ease;
}

.cart-drawer__note-toggle[aria-expanded='true'] + .cart-drawer__note-panel {
  grid-template-rows: 1fr;
}

.cart-drawer__note-inner {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  min-height: 0;
  overflow: hidden;
}

.cart-drawer__note-field {
  width: 100%;
  padding: var(--space-3);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-m);
  font-family: var(--font-body);
  font-size: 14px;
  resize: vertical;
}

.cart-drawer__note-field:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

.cart-drawer__note-status {
  min-height: 1.2em;
  margin: 0 0 var(--space-3);
  font-size: 13px;
  color: var(--color-secondary);
}

@media (prefers-reduced-motion: reduce) {
  .cart-drawer__note-panel {
    transition: none;
  }
}

.cart-drawer__summary-row--total {
  font-size: 16px;
  font-weight: 600;
  font-family: var(--font-accent);
}

.cart-drawer__checkout {
  width: 100%;
}

.cart-drawer__empty {
  flex: 1;
  text-align: center;
  padding: 60px 0;
}

.cart-drawer__empty-heading {
  font-size: 18px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
  margin: 0 0 var(--space-5);
}

/* Lock scroll on <html>, not <body>: base.css sets html { overflow-x: clip },
   so a body { overflow: hidden } doesn't propagate to the viewport - it turns
   body into its own scroll container, which breaks position: sticky for every
   descendant (the product page's sticky gallery/info dropped out of place
   whenever the drawer opened). No scrollbar-gutter here on purpose: the
   reserved gutter sits outside the fixed drawer/backdrop's containing
   block, so it showed as an uncovered strip to the right of the drawer. */
html:has(body.cart-drawer-open) {
  overflow: hidden;
}
{% endstylesheet %}

{% javascript %}
class CartDrawer {
  #root
  #backdrop
  #closeButton
  #content

  #lastFocused

  constructor() {
    this.#root = document.getElementById('CartDrawer')
    this.#backdrop = document.getElementById('CartDrawerBackdrop')
    this.#closeButton = document.getElementById('CartDrawerClose')
    this.#content = document.getElementById('CartDrawerContent')
    if (!this.#root || !this.#backdrop || !this.#content) return

    document.addEventListener('cart:open', () => this.open())
    document.addEventListener('cart:updated', (event) => this.#onCartUpdated(event))
    this.#closeButton.addEventListener('click', () => this.close())
    this.#backdrop.addEventListener('click', () => this.close())
    document.addEventListener('keydown', (event) => this.#onKeydown(event))
    document.addEventListener('click', (event) => this.#onNoteClick(event))
  }

  // Order note: the toggle opens/closes the panel; Save posts the note to the cart.
  #onNoteClick(event) {
    const toggle = event.target.closest('[data-note-toggle]')
    if (toggle) {
      const open = toggle.getAttribute('aria-expanded') !== 'true'
      toggle.setAttribute('aria-expanded', String(open))
      if (open) toggle.closest('[data-cart-note]')?.querySelector('[data-note-field]')?.focus()
      return
    }

    const save = event.target.closest('[data-note-save]')
    if (save) this.#saveNote(save.closest('[data-cart-note]'), save)
  }

  async #saveNote(wrapper, button) {
    const field = wrapper?.querySelector('[data-note-field]')
    const status = wrapper?.querySelector('[data-note-status]')
    const label = wrapper?.querySelector('[data-note-label]')
    if (!field || !status) return

    button.disabled = true
    try {
      const response = await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ note: field.value })
      })
      if (!response.ok) throw new Error(response.statusText)
      status.textContent = status.dataset.saved
      if (label) label.textContent = field.value.trim() ? label.dataset.labelEdit : label.dataset.labelAdd
    } catch (error) {
      status.textContent = status.dataset.failed
    } finally {
      button.disabled = false
    }
  }

  open() {
    this.#lastFocused = document.activeElement
    this.#root.hidden = false
    this.#root.inert = false
    this.#backdrop.hidden = false
    requestAnimationFrame(() => {
      this.#root.classList.add('is-open')
      this.#backdrop.classList.add('is-open')
    })
    this.#root.setAttribute('aria-hidden', 'false')
    this.#closeButton.focus()
    document.body.classList.add('cart-drawer-open')
  }

  close() {
    this.#root.classList.remove('is-open')
    this.#backdrop.classList.remove('is-open')
    this.#root.setAttribute('aria-hidden', 'true')
    this.#root.inert = true
    document.body.classList.remove('cart-drawer-open')
    window.setTimeout(() => {
      if (!this.#root.classList.contains('is-open')) {
        this.#root.hidden = true
        this.#backdrop.hidden = true
      }
    }, 300)
    this.#lastFocused?.focus()
  }

  #onCartUpdated(event) {
    const sections = event.detail?.sections
    if (!sections || !sections['cart-drawer']) return
    const doc = new DOMParser().parseFromString(sections['cart-drawer'], 'text/html')

    const newContent = doc.getElementById('CartDrawerContent')
    if (newContent) {
      this.#content.innerHTML = newContent.innerHTML
      this.#content.classList.remove('is-loading')
    }

    const newFooter = doc.getElementById('CartDrawerFooter')
    const currentFooter = this.#root.querySelector('#CartDrawerFooter')
    currentFooter?.remove()
    if (newFooter) this.#content.after(newFooter)

    if (event.detail.openDrawer !== false) this.open()
  }

  #onKeydown(event) {
    if (event.key === 'Escape' && this.#root.classList.contains('is-open')) {
      this.close()
    }
  }
}

document.addEventListener('DOMContentLoaded', () => new CartDrawer())
{% endjavascript %}

