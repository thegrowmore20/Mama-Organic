{%- comment -%}
  Blog listing page. Inspired by Dawn's main-blog.liquid structurally
  (breadcrumb, heading, article grid, load more) but rebuilt on this theme's
  own conventions: .container/.section-padding, plain-string schema names,
  and top-level checkbox settings instead of Dawn's block-based toggles.
{%- endcomment -%}

<section
  class="blog-listing section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --blog-columns-desktop: {{ section.settings.columns_desktop }};"
>
  <div class="container">
    <nav class="blog-listing__breadcrumb" aria-label="breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a></li>
        <li aria-current="page">{{ blog.title }}</li>
      </ol>
    </nav>

    <h1 class="blog-listing__title h2">{{ blog.title }}</h1>

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- if blog.articles.size > 0 -%}
        <h2 class="visually-hidden">{{ 'blogs.general.articles_heading' | t }}</h2>
        <div class="u-grid blog-listing__grid" data-blog-grid data-section-id="{{ section.id }}">
          {%- for article in blog.articles -%}
            {%- render 'article-card',
              article: article,
              blog: blog,
              show_image: section.settings.show_image,
              show_excerpt: section.settings.show_excerpt,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_comments: section.settings.show_comments
            -%}
          {%- endfor -%}
        </div>

        {%- comment -%}
          Load more instead of numbered pages. It is a real link to the next page, so it
          still works without JavaScript; the script below fetches that page and appends
          its articles to the grid.
        {%- endcomment -%}
        {%- if paginate.next -%}
          <div class="u-flex u-justify-center collection-load-more" data-load-more-wrap>
            <a href="{{ paginate.next.url }}" class="button button--accent collection-load-more__button" data-blog-load-more>
              {{ 'collections.general.load_more' | t }}
            </a>
          </div>
        {%- endif -%}
      {%- else -%}
        <p class="blog-listing__empty">{{ 'blogs.general.no_articles' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
.blog-listing__breadcrumb ol {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0;
  padding: 0 0 15px;
  font-size: 14px;
  color: var(--color-text-muted);
  list-style: none;
}

.blog-listing__breadcrumb li {
  display: flex;
  align-items: center;
  gap: 6px;
}

.blog-listing__breadcrumb li:not(:last-child)::after {
  content: '/';
  color: var(--color-text-muted);
}

.blog-listing__breadcrumb a {
  color: var(--color-text-muted);
}

.blog-listing__breadcrumb a:hover {
  color: var(--color-secondary);
}

.blog-listing__breadcrumb li[aria-current='page'] {
  color: var(--color-primary);
}

@media screen and (max-width: 749px) {
  .blog-listing__breadcrumb ol {
    font-size: 12px;
  }
}

.blog-listing__title {
  color: var(--color-primary);
  margin: 0 0 var(--space-8);
}

.blog-listing__grid {
  grid-template-columns: 1fr;
  gap: var(--space-3);
}

@media screen and (min-width: 750px) {
  .blog-listing__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
}

@media screen and (min-width: 990px) {
  .blog-listing__grid {
    grid-template-columns: repeat(var(--blog-columns-desktop, 3), minmax(0, 1fr));
  }
}

.blog-listing-card {
  display: flex;
  flex-direction: column;
  transform-origin: center;
  transition: transform 0.25s ease;
  backface-visibility: hidden;
}

.blog-listing-card__meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin: 0 0 var(--space-2);
}

.blog-listing-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.blog-listing-card__comments {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--color-text-muted);
}

.blog-listing__empty {
  color: var(--color-primary);
  padding: 40px 0;
}
{% endstylesheet %}

{% javascript %}
// Appends the next page of articles to the grid, then swaps in the next Load more button
// (or removes it on the last page).
document.addEventListener('click', async (event) => {
  const button = event.target.closest('[data-blog-load-more]')
  if (!button) return
  event.preventDefault()
  if (button.getAttribute('aria-busy') === 'true') return
  button.setAttribute('aria-busy', 'true')
  button.classList.add('is-loading')

  try {
    const grid = document.querySelector('[data-blog-grid]')
    const url = new URL(button.href, window.location.origin)
    url.searchParams.set('section_id', grid.dataset.sectionId)
    const response = await fetch(url)
    const doc = new DOMParser().parseFromString(await response.text(), 'text/html')

    for (const article of doc.querySelectorAll('[data-blog-grid] > *')) {
      grid.append(document.importNode(article, true))
    }

    const wrap = button.closest('[data-load-more-wrap]')
    const nextWrap = doc.querySelector('[data-load-more-wrap]')
    if (nextWrap) wrap?.replaceWith(document.importNode(nextWrap, true))
    else wrap?.remove()
  } catch (error) {
    console.error('Load more error:', error)
    button.removeAttribute('aria-busy')
    button.classList.remove('is-loading')
  }
})
{% endjavascript %}

{% schema %}
{
  "name": "Blog",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 9
    },
    {
      "type": "header",
      "content": "Article card"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Show comment count",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ]
}
{% endschema %}
