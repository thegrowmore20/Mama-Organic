{%- liquid
  assign text_bg = section.settings.text_background
  assign text_align = section.settings.text_alignment | default: 'left'
  assign text_color = 'var(--color-primary)'
  if text_bg != blank
    assign bg_brightness = text_bg | color_brightness
    if bg_brightness <= 150
      assign text_color = '#ffffff'
    endif
  endif
  assign has_content = false
  if section.settings.heading != blank or section.settings.subheading != blank or section.settings.text != blank or section.settings.text_image != blank
    assign has_content = true
  endif
  assign has_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign has_button = true
    assign has_content = true
  endif
-%}

<section
  class="image-with-text section-padding{% if section.settings.image_position == 'right' %} image-with-text--reverse{% endif %}"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <div class="image-with-text__grid u-grid">
      <div class="image-with-text__media">
        {%- if section.settings.image -%}
          {%- assign media_alt = section.settings.image.alt | default: section.settings.heading -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700, 1000, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: media_alt, class: 'image-with-text__image' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'image-with-text__image image-with-text__placeholder' }}
        {%- endif -%}
      </div>

      {%- if has_content -%}
        <div
          class="image-with-text__content u-flex u-flex-col u-justify-center image-with-text__content--{{ text_align }}{% if text_bg != blank %} image-with-text__content--custom{% endif %}"
          {%- if text_bg != blank %} style="--image-with-text-bg: {{ text_bg }}; --image-with-text-color: {{ text_color }};"{% endif -%}
        >
          {% render 'section-header',
            heading: section.settings.heading,
            subheading: section.settings.subheading,
            alignment: text_align
          %}
          {%- if section.settings.text != blank -%}
            <div class="image-with-text__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.settings.text_image != blank -%}
            {%- assign text_image_alt = section.settings.text_image.alt | default: section.settings.heading -%}
            <div class="image-with-text__text-image" style="--image-with-text-image-width: {{ section.settings.text_image_width }}px;">
              {{ section.settings.text_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 600, 900, 1200', sizes: '(min-width: 750px) 40vw, 90vw', alt: text_image_alt }}
            </div>
          {%- endif -%}
          {%- if has_button -%}
            <a
              href="{{ section.settings.button_link }}"
              class="button button--accent image-with-text__button"
              {%- if section.settings.button_color != blank or section.settings.button_text_color != blank %} style="
                {%- if section.settings.button_color != blank %}background: {{ section.settings.button_color }};{% endif -%}
                {%- if section.settings.button_text_color != blank %}color: {{ section.settings.button_text_color }};{% endif -%}
              "{% endif -%}
            >
              {{ section.settings.button_label | escape }}
              {%- if section.settings.heading != blank -%}
                <span class="visually-hidden"> &ndash; {{ section.settings.heading | escape }}</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.image-with-text__grid {
  grid-template-columns: 1fr;
  overflow: hidden;
  border-radius: var(--radius-m);
}

.image-with-text__media {
  min-height: 280px;
}

.image-with-text__image {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 280px;
  object-fit: cover;
}

.image-with-text__placeholder {
  fill: var(--color-primary);
  opacity: 0.4;
}

.image-with-text__content {
  align-items: flex-start;
  gap: var(--space-4);
  padding: 40px var(--space-4);
  background: var(--color-surface);
  color: var(--color-primary);
}

/* Text position: the section-header gets its own text-align inline; this
   aligns the rest of the stack (rich text, image, button), which is a flex
   column, with the same choice. */
.image-with-text__content--left {
  align-items: flex-start;
  text-align: left;
}

.image-with-text__content--center {
  align-items: center;
  text-align: center;
}

.image-with-text__content--right {
  align-items: flex-end;
  text-align: right;
}

.image-with-text__content--custom {
  background: var(--image-with-text-bg, var(--color-surface));
  color: var(--image-with-text-color, var(--color-primary));
}

.image-with-text__text {
  max-width: 480px;
}

/* Keep the max-width text block's edge on the chosen side: auto margins on
   the cross axis place it at the start, centre or end of the column. */
.image-with-text__content--center .image-with-text__text,
.image-with-text__content--center .section-header {
  margin-inline: auto;
}

.image-with-text__content--right .image-with-text__text {
  margin-inline-start: auto;
}

.image-with-text__text > :first-child {
  margin-top: 0;
}

.image-with-text__text > :last-child {
  margin-bottom: 0;
}

.image-with-text__text-image {
  width: 100%;
  max-width: var(--image-with-text-image-width, 300px);
}

.image-with-text__text-image img {
  display: block;
  width: 100%;
  height: auto;
}

.image-with-text__button {
  padding: 14px var(--space-8);
}

/* The shared section-header brings its own bottom margin and heading color;
   inside this block the content owns the spacing and the text color follows
   the chosen background. */
.image-with-text__content .section-header {
  margin: 0;
}

.image-with-text__content .section-header__heading,
.image-with-text__content .section-header__subheading {
  color: inherit;
}

@media screen and (min-width: 750px) {
  .image-with-text__grid {
    grid-template-columns: 1fr 1fr;
  }

  .image-with-text__content {
    padding: 48px var(--space-8);
  }

  /* Only the visual order flips - the DOM keeps image first so the reading
     order stays heading-after-image on every screen. */
  .image-with-text--reverse .image-with-text__media {
    order: 2;
  }

  .image-with-text--reverse .image-with-text__content {
    order: 1;
  }
}

/* Same content padding as the split banner on wide screens. */
@media screen and (min-width: 1200px) {
  .image-with-text__content {
    padding: 48px 7em;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "A placeholder shows until you add an image."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pair an image with a short message."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "text_image",
      "label": "Image below text",
      "info": "Shown under the text and above the button, for example a row of logos."
    },
    {
      "type": "range",
      "id": "text_image_width",
      "label": "Image below text width",
      "min": 80,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "color",
      "id": "text_background",
      "label": "Text background color",
      "info": "Leave empty to use the theme surface color. Text color adjusts to stay readable."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "The button shows when both a label and a link are set."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "info": "Leave empty to use the theme button color."
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "info": "Leave empty to use the theme button text color."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
