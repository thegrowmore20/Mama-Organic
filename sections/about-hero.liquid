<section
  class="about-hero section-padding"
  style="
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  "
>
  <div class="container">
    <div class="about-hero__layout">

      <div class="about-hero__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '500, 750, 900, 1200',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: section.settings.image.alt | default: section.settings.heading,
              class: 'about-hero__image'
          }}
        {%- else -%}
          <div class="about-hero__placeholder">{% render 'icon', name: 'sparkle' %}</div>
        {%- endif -%}
      </div>

      <div class="about-hero__content">
        {%- if section.settings.subheading != blank -%}
          <p class="about-hero__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="about-hero__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="about-hero__description">{{ section.settings.description }}</div>
        {%- endif -%}
        {%- if section.settings.certifications_image != blank -%}
          <div class="about-hero__certifications">
            {{
              section.settings.certifications_image
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600',
                sizes: '(min-width: 750px) 40vw, 100vw',
                alt: section.settings.certifications_image.alt | default: '',
                class: 'about-hero__cert-img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div class="about-hero__actions">
            <a href="{{ section.settings.button_link | default: routes.root_url }}" class="button about-hero__button">
              {{ section.settings.button_label }}
              {% render 'icon', name: 'arrow-right' %}
            </a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
.about-hero__layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  align-items: center;
}

@media screen and (min-width: 750px) {
  .about-hero__layout {
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
}

.about-hero__image {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 20px;
}

.about-hero__placeholder {
  aspect-ratio: 4 / 3;
  background: var(--color-surface);
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-secondary);
}

.about-hero__placeholder svg {
  width: 64px;
  height: 64px;
}

.about-hero__subheading {
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-secondary);
  margin: 0 0 14px;
}

.about-hero__heading {
  font-size: clamp(26px, 3.5vw, 40px);
  line-height: 1.2;
  color: var(--color-primary);
  margin: 0 0 20px;
}

.about-hero__description {
  font-size: 16px;
  line-height: 1.75;
  color: var(--color-text);
  max-width: 46ch;
}

.about-hero__description p {
  margin: 0;
}

.about-hero__description p + p {
  margin-top: var(--space-3);
}

.about-hero__certifications {
  margin-top: var(--space-6);
}

.about-hero__cert-img {
  width: auto;
  max-width: 100%;
  height: auto;
  display: block;
}

.about-hero__actions {
  margin-top: var(--space-7);
}

.about-hero__button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--color-primary);
  color: #fff;
}

.about-hero__button svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

@media (hover: hover) and (pointer: fine) {
  .about-hero__button:hover {
    background: var(--color-secondary);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "About hero",
  "class": "section",
  "settings": [
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background color",
      "default": "#faf6f1"
    },
    {
      "type": "header",
      "content": "Left — Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Right — Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Mission – Goodness Of Nature"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>At MamaOrganic, we believe in the power of nature. Our commitment is to make our community happier and healthier by sharing the goodness of natural beauty and self-care.</p>"
    },
    {
      "type": "image_picker",
      "id": "certifications_image",
      "label": "Certifications image",
      "info": "Upload a single image showing all certification badges (GMP, ISO, HALAL, etc.)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "About hero"
    }
  ]
}
{% endschema %}
