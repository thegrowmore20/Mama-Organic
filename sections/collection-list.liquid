<section class="collections-section section-padding" style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {% render 'section-header', heading: section.settings.heading %}

    <div class="collections-grid" style="--collections-columns-desktop: {{ section.settings.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- assign card_title = block.settings.title | default: collection.title -%}
        {%- assign card_image = block.settings.image | default: collection.featured_image -%}
        <a class="collection-card" href="{{ collection.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          <div class="collection-card__media">
            {%- if card_image -%}
              {{ card_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1200px) 200px, (min-width: 600px) 30vw, 45vw', alt: card_title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          {%- if card_title != blank -%}
            <h3 class="collection-card__title">{{ card_title }}</h3>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* Flex, not grid: a wrapping flex row centres every row, including a short
   last one (e.g. 5 + 4 items), which a fixed-column grid would left-align.
   Each card takes an equal share of the row, so --collections-columns-desktop
   items fit per row. */
.collections-grid {
  --collections-columns: 2;
  --collections-gap: var(--space-3);
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--collections-gap);

  @media screen and (min-width: 600px) {
    --collections-columns: 3;
  }
}

@media screen and (min-width: 1200px) {
  .collections-grid {
    --collections-columns: var(--collections-columns-desktop, 5);
    --collections-gap: var(--space-4);
  }
}

.collection-card {
  display: block;
  flex: 0 0 calc((100% - (var(--collections-columns) - 1) * var(--collections-gap)) / var(--collections-columns));
  min-width: 0;
  text-align: center;
  transform-origin: center;
  transition: transform 0.25s ease;
  backface-visibility: hidden;
}

.collection-card:hover {
  transform: translateY(-5px);
}

/* Images keep their own aspect ratio (no fixed height or crop) and are
   centred in the card. */
.collection-card__media {
  display: block;
  overflow: hidden;
  border-radius: var(--radius-m);
}

.collection-card__media img {
  display: block;
  width: 100%;
  height: auto;
  margin: 0 auto;
}

.collection-card__title {
  margin: var(--space-2) 0 0;
  font-size: 16px;
  font-weight: var(--font-accent-weight);
  font-family: var(--font-accent);
  color: var(--color-primary);

  @media screen and (max-width: 749px) {
    font-size: 14px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Concern"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Items per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
