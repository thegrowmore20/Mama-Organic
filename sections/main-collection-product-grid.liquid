{%- liquid
  assign show_sidebar = false
  if section.settings.enable_filtering or section.blocks.size > 0
    assign show_sidebar = true
  endif
-%}

<collection-results
  class="collection-grid-section section-padding"
  data-section-id="{{ section.id }}"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --grid-columns-mobile: {{ section.settings.columns_mobile }}; --grid-columns-desktop: {{ section.settings.columns_desktop }};"
>
  <div class="container">
    <nav class="collection-breadcrumb" aria-label="breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a></li>
        <li aria-current="page">{{ collection.title }}</li>
      </ol>
    </nav>

    <h2 class="visually-hidden">{{ 'products.facets.heading' | t }}</h2>

    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="collection-layout{% if show_sidebar %} collection-layout--has-sidebar{% endif %}">
        <div class="u-grid u-items-center collection-topbar">
          {%- if show_sidebar -%}
            <collection-filters class="collection-filters">
              <button
                type="button"
                class="collection-filters__toggle"
                aria-expanded="false"
                aria-controls="CollectionFiltersPanel-{{ section.id }}"
              >
                {% render 'icon', name: 'filter' %}
                <span>{{ 'products.facets.filter_button' | t }}</span>
              </button>
              <div class="collection-filters__backdrop" data-filters-backdrop hidden></div>
              <div
                class="u-flex u-flex-col collection-filters__panel"
                id="CollectionFiltersPanel-{{ section.id }}"
                role="dialog"
                aria-modal="true"
                aria-label="{{ 'products.facets.filter_button' | t }}"
                hidden
              >
                <div class="u-flex u-items-center u-justify-between collection-filters__panel-header">
                  <p class="collection-filters__panel-heading">{{ 'products.facets.filter_button' | t }}</p>
                  <button type="button" class="u-inline-flex u-items-center u-justify-center collection-filters__panel-close" data-filters-close aria-label="{{ 'general.accessibility.close' | t }}">
                    {% render 'icon', name: 'close' %}
                  </button>
                </div>
                <div class="collection-filters__panel-inner" data-filters-panel>
                  {% render 'facets', results: collection, section: section %}
                </div>
              </div>
            </collection-filters>
          {%- elsif section.settings.enable_sorting -%}
            {%- comment -%} No filter groups to show, but the sort <select> still needs a form to submit via its form="" attribute. {%- endcomment -%}
            <form id="FacetFiltersForm-{{ section.id }}" class="visually-hidden"></form>
          {%- endif -%}

          <p class="collection-toolbar__count" role="status">
            <span data-product-count>
              {%- if collection.products_count == collection.all_products_count -%}
                {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
              {%- else -%}
                {{ 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
              {%- endif -%}
            </span>
          </p>

          {%- if section.settings.enable_sorting -%}
            <div class="u-flex u-items-center collection-toolbar__sort">
              <label for="SortBy-{{ section.id }}" class="collection-toolbar__sort-label">{{ 'products.facets.sort_by_label' | t }}</label>
              <select name="sort_by" form="FacetFiltersForm-{{ section.id }}" id="SortBy-{{ section.id }}" class="collection-toolbar__select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
                    {{ option.name | escape }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
        </div>

        <div data-grid-container>
          {%- if collection.products.size == 0 -%}
            <div class="collection-empty">
              <p class="h4">{{ 'collections.general.empty' | t }}</p>
              <p>{{ 'collections.general.use_fewer_filters_html' | t: link: collection.url, class: 'collection-empty__link' }}</p>
            </div>
          {%- else -%}
            <ul class="u-grid collection-grid" id="product-grid-{{ section.id }}">
              {%- for product in collection.products -%}
                <li class="collection-grid__item">
                  {% render 'product-card', product: product %}
                </li>
              {%- endfor -%}
            </ul>

            {%- comment -%}
              Load more instead of numbered pages. It is a real link to the next
              page, so it still works without JavaScript; the script below
              fetches that page and appends its products to the grid.
            {%- endcomment -%}
            {%- if paginate.next -%}
              <div class="collection-load-more" data-load-more-wrap>
                <a href="{{ paginate.next.url }}" class="button button--accent collection-load-more__button" data-load-more>
                  {{ 'collections.general.load_more' | t }}
                </a>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</collection-results>

{% stylesheet %}
collection-results,
collection-filters,
price-range-slider {
  display: block;
}

/* ---------- Breadcrumb ---------- */
.collection-breadcrumb {
  margin-bottom: var(--space-5);
}

.collection-breadcrumb ol {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0;
  font-size: 14px;
  color: var(--color-text-muted);
  padding: 0;
  padding-bottom: 15px;
}

.collection-breadcrumb li {
  display: flex;
  align-items: center;
  gap: 6px;
}

.collection-breadcrumb li:not(:last-child)::after {
  content: '/';
  color: var(--color-text-muted);
}

.collection-breadcrumb a {
  color: var(--color-text-muted);
}

.collection-breadcrumb a:hover {
  color: var(--color-secondary);
}

.collection-breadcrumb li[aria-current="page"] {
  color: var(--color-primary);
}

@media screen and (max-width: 749px) {
  .collection-breadcrumb {
    margin-bottom: 0;
  }

  .collection-breadcrumb ol {
    font-size: 12px;
  }
}

/* ---------- Layout ---------- */

@media screen and (min-width: 990px) {

  /* .collection-topbar is a real grid row on mobile/tablet (filter, count, sort
     side by side) but dissolves here so its children become direct items of
     this outer grid instead — letting the sidebar span both rows in column 1
     while count/sort share column 2's top row (see justify-self split below). */
}

/* ---------- Topbar row: filter trigger (left) / count (center) / sort (right) ---------- */

.collection-topbar > collection-filters,
.collection-topbar > form.visually-hidden {
  grid-column: 1;
}

.collection-toolbar__sort {
  grid-column: 3;
}

/* ---------- Filter drawer (mobile/tablet) / static sidebar (desktop) ---------- */

body.collection-filters-open {
  overflow: hidden;
}

@media screen and (min-width: 990px) {

  /* The panel is server-rendered with `hidden` (closed by default) since the
     mobile drawer starts closed; JS only ever removes it on mobile via open().
     On desktop it's always the static sidebar, so force it visible regardless. */
}

/* ---------- Facets ---------- */

/* Smooth open/close for the filter accordions. interpolate-size lets the
   details content animate between 0 and its natural height; browsers without
   ::details-content support simply open instantly, as before. */
.facets__group,
.facets__sub {
  interpolate-size: allow-keywords;
}

@supports selector(::details-content) {
  .facets__group::details-content,
  .facets__sub::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 0.3s ease, content-visibility 0.3s ease allow-discrete;
  }

  .facets__group[open]::details-content,
  .facets__sub[open]::details-content {
    block-size: auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  .facets__group::details-content,
  .facets__sub::details-content {
    transition: none;
  }
}

.facets__list {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

/* Third-level menus: a second-level link that has children is its own
   accordion. Its summary holds the checkbox row plus a chevron; the third
   level is indented under it. */
.facets__sub-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  cursor: pointer;
  list-style: none;
}

.facets__sub-summary::-webkit-details-marker {
  display: none;
}

details[open] > .facets__sub-summary .facets__chevron--down {
  transform: rotate(180deg);
}

/* Navigation menu lists: 15px in from the group title, and a tighter 5px gap
   between rows (the real filter lists keep their own 10px). */
.facets__list--nav {
  padding-inline-start: 15px;
}

.facets__list--nav,
.facets__list--nested {
  gap: 5px;
}

.facets__list--nested {
  margin-top: 5px;
  padding-inline-start: 14px;
}

/* Navigation menu rows are plain links. The active link is highlighted with
   the brand color and a soft background; a link that contains the active one
   is tinted in the brand color too, so the open path reads at every level. */
.facets__nav-link {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 5px 8px;
  margin-inline: -8px;
  border-radius: var(--radius-s);
  font-size: 14px;
  color: var(--color-primary);
  transition: background-color 0.2s ease, color 0.2s ease;
}

.facets__nav-link.is-parent-active {
  color: var(--color-secondary);
}

.facets__nav-link.is-active {
  background: var(--color-surface);
  color: var(--color-secondary);
  font-weight: 600;
}

/* First level: titles are dark green; the group on the active path (it holds
   the active link, or is the current page itself) turns the brand teal. Only the
   color changes - no background - unlike the active second/third-level link. */
.facets__group--active > .facets__summary > span:first-child,
.facets__group--parent-active > .facets__summary > span:first-child,
.facets__group--active > .facets__summary .facets__chevron,
.facets__group--parent-active > .facets__summary .facets__chevron {
  color: var(--color-secondary);
}

/* A second-level link that has children: the link takes the row, the chevron
   stays on the right and toggles the third level. */
.facets__sub-summary .facets__nav-link {
  flex: 1 1 auto;
  width: auto;
}

/* The count on a quick-link row sits inside the bold group label - keep it
   regular weight like the counts beside each filter value. */

/* ---------- Active filter pills ---------- */

/* ---------- Price range slider ---------- */

/* The runnable track is set to the same height as the thumb so both browsers'
   native thumb-centering math lands the thumb exactly on the visual track
   above, instead of needing a manual (and easily-wrong) pixel offset. */

/* ---------- Toolbar sort control ---------- */
.collection-toolbar__sort {
  gap: var(--space-2);
  font-size: 13px;
  color: var(--color-primary);
}

/* ---------- Grid ---------- */

.pagination {
  gap: var(--space-2);
  margin-top: var(--space-8);
}
{% endstylesheet %}

{% javascript %}
class CollectionFilters extends HTMLElement {
  #toggle
  #backdrop
  #panel
  #closeButton
  #lastFocused

  constructor() {
    super()
    this.#toggle = this.querySelector('.collection-filters__toggle')
    this.#backdrop = this.querySelector('[data-filters-backdrop]')
    this.#panel = this.querySelector('.collection-filters__panel')
    this.#closeButton = this.querySelector('[data-filters-close]')
    if (!this.#panel) return

    this.#toggle?.addEventListener('click', () => this.open())
    this.#closeButton?.addEventListener('click', () => this.close())
    this.#backdrop?.addEventListener('click', () => this.close())
    document.addEventListener('keydown', (event) => this.#onKeydown(event))
  }

  open() {
    this.#lastFocused = document.activeElement
    this.#panel.hidden = false
    if (this.#backdrop) this.#backdrop.hidden = false
    requestAnimationFrame(() => {
      this.#panel.classList.add('is-open')
      this.#backdrop?.classList.add('is-open')
    })
    this.#toggle?.setAttribute('aria-expanded', 'true')
    document.body.classList.add('collection-filters-open')
    this.#closeButton?.focus()
  }

  close() {
    this.#panel.classList.remove('is-open')
    this.#backdrop?.classList.remove('is-open')
    this.#toggle?.setAttribute('aria-expanded', 'false')
    document.body.classList.remove('collection-filters-open')
    window.setTimeout(() => {
      if (!this.#panel.classList.contains('is-open')) {
        this.#panel.hidden = true
        if (this.#backdrop) this.#backdrop.hidden = true
      }
    }, 300)
    this.#lastFocused?.focus()
  }

  #onKeydown(event) {
    if (event.key === 'Escape' && this.#panel.classList.contains('is-open')) this.close()
  }
}

class PriceRangeSlider extends HTMLElement {
  #minThumb
  #maxThumb
  #minInput
  #maxInput
  #progress
  #min
  #max

  constructor() {
    super()
    this.#minThumb = this.querySelector('[data-price-thumb-min]')
    this.#maxThumb = this.querySelector('[data-price-thumb-max]')
    this.#minInput = this.querySelector('[data-price-input-min]')
    this.#maxInput = this.querySelector('[data-price-input-max]')
    this.#progress = this.querySelector('[data-price-progress]')
    if (!this.#minThumb || !this.#maxThumb) return

    this.#min = Number(this.#minThumb.min)
    this.#max = Number(this.#minThumb.max)

    this.#minThumb.addEventListener('input', () => this.#onThumbInput('min'))
    this.#maxThumb.addEventListener('input', () => this.#onThumbInput('max'))
    this.#minThumb.addEventListener('pointerdown', () => this.#raise('min'))
    this.#maxThumb.addEventListener('pointerdown', () => this.#raise('max'))
    this.#minInput?.addEventListener('change', () => this.#onTextInput('min'))
    this.#maxInput?.addEventListener('change', () => this.#onTextInput('max'))

    this.#updateProgress()
  }

  #raise(which) {
    this.#minThumb.style.zIndex = which === 'min' ? '5' : '1'
    this.#maxThumb.style.zIndex = which === 'max' ? '5' : '1'
  }

  #onThumbInput(which) {
    let minVal = Number(this.#minThumb.value)
    let maxVal = Number(this.#maxThumb.value)
    if (minVal > maxVal) {
      if (which === 'min') {
        minVal = maxVal
        this.#minThumb.value = String(minVal)
      } else {
        maxVal = minVal
        this.#maxThumb.value = String(maxVal)
      }
    }
    if (this.#minInput) this.#minInput.value = minVal.toFixed(2)
    if (this.#maxInput) this.#maxInput.value = maxVal.toFixed(2)
    this.#updateProgress()
  }

  #onTextInput(which) {
    const raw = which === 'min' ? this.#minInput.value : this.#maxInput.value
    let value = Number.parseFloat(String(raw).replace(',', '.'))
    if (Number.isNaN(value)) value = which === 'min' ? this.#min : this.#max
    value = Math.min(Math.max(value, this.#min), this.#max)

    if (which === 'min') {
      value = Math.min(value, Number(this.#maxThumb.value))
      this.#minThumb.value = String(value)
      this.#minInput.value = value.toFixed(2)
    } else {
      value = Math.max(value, Number(this.#minThumb.value))
      this.#maxThumb.value = String(value)
      this.#maxInput.value = value.toFixed(2)
    }
    this.#updateProgress()
  }

  #updateProgress() {
    if (!this.#progress) return
    const min = Number(this.#minThumb.value)
    const max = Number(this.#maxThumb.value)
    const range = this.#max - this.#min || 1
    const left = ((min - this.#min) / range) * 100
    const right = 100 - ((max - this.#min) / range) * 100
    this.#progress.style.left = `${left}%`
    this.#progress.style.right = `${right}%`
  }
}

class CollectionResults extends HTMLElement {
  #sectionId
  #grid
  #count
  #filtersPanel

  constructor() {
    super()
    this.#sectionId = this.dataset.sectionId
    this.#grid = this.querySelector('[data-grid-container]')
    this.#count = this.querySelector('[data-product-count]')
    this.#filtersPanel = this.querySelector('[data-filters-panel]')

    this.addEventListener('change', (event) => this.#onChange(event))
    this.addEventListener('click', (event) => this.#onClick(event))
    window.addEventListener('popstate', () => this.#fetchAndRender(window.location.href, false))
  }

  #onChange(event) {
    const target = event.target
    if (!(target instanceof HTMLInputElement) && !(target instanceof HTMLSelectElement)) return

    if (target.hasAttribute('data-nav-url')) {
      if (target.checked) window.location.href = target.dataset.navUrl
      return
    }

    if (
      target.matches('select[name="sort_by"]') ||
      target.matches('input[type="checkbox"]') ||
      target.matches('input[type="range"]') ||
      target.matches('[data-price-input-min], [data-price-input-max]')
    ) {
      this.#submitForm()
    }
  }

  #onClick(event) {
    const loadMore = event.target.closest('[data-load-more]')
    if (loadMore) {
      event.preventDefault()
      this.#loadMore(loadMore)
      return
    }

    const priceRemove = event.target.closest('[data-price-pill] .active-filters__remove')
    if (priceRemove) {
      const pill = priceRemove.closest('[data-price-pill]')
      const form = this.querySelector('form')
      const minInput = form?.querySelector(`[name="${pill.dataset.minName}"]`)
      const maxInput = form?.querySelector(`[name="${pill.dataset.maxName}"]`)
      if (minInput) minInput.value = ''
      if (maxInput) maxInput.value = ''
      this.#submitForm()
      return
    }

    const link = event.target.closest(
      '.active-filters__pill[href], .active-filters__clear-all[href], .pagination__link[href]'
    )
    if (link) {
      event.preventDefault()
      this.#fetchAndRender(link.href)
    }
  }

  // Fetches the next page of the current results (filters and sorting stay in
  // the link's URL) and appends its products to the grid, then swaps in the
  // next Load more button - or removes it on the last page.
  async #loadMore(button) {
    if (button.getAttribute('aria-busy') === 'true') return
    button.setAttribute('aria-busy', 'true')
    button.classList.add('is-loading')

    try {
      const url = new URL(button.href, window.location.origin)
      url.searchParams.set('section_id', this.#sectionId)
      const response = await fetch(url)
      const text = await response.text()
      const doc = new DOMParser().parseFromString(text, 'text/html')

      const list = this.#grid?.querySelector('.collection-grid')
      if (!list) return
      for (const item of doc.querySelectorAll('[data-grid-container] .collection-grid__item')) {
        list.append(document.importNode(item, true))
      }

      const wrap = button.closest('[data-load-more-wrap]')
      const nextWrap = doc.querySelector('[data-grid-container] [data-load-more-wrap]')
      if (nextWrap) {
        wrap?.replaceWith(document.importNode(nextWrap, true))
      } else {
        wrap?.remove()
      }

      // New cards carry Judge.me rating badges - ask Judge.me to style them.
      // Judge.me only styles the rating badges that existed when its script ran,
      // so ask it to render the ones just added (the call differs by version, and
      // the script can still be busy, so run it again a moment later).
      const refreshReviewBadges = () => {
        for (const name of ['batchRenderBadges', 'customizeBadges']) window.jdgm?.[name]?.()
      }
      refreshReviewBadges()
      setTimeout(refreshReviewBadges, 400)
    } catch (error) {
      console.error('Load more error:', error)
      button.removeAttribute('aria-busy')
      button.classList.remove('is-loading')
    }
  }

  #submitForm() {
    const form = this.querySelector('form')
    if (!form) return
    const params = new URLSearchParams(new FormData(form))

    // The price slider always has a value, even at its full default range — don't
    // submit it as an active filter (and show a misleading pill) unless narrowed.
    const minThumb = this.querySelector('[data-price-thumb-min]')
    const maxThumb = this.querySelector('[data-price-thumb-max]')
    const minInput = this.querySelector('[data-price-input-min]')
    const maxInput = this.querySelector('[data-price-input-max]')
    if (minThumb && maxThumb && minInput && maxInput) {
      const atDefaultRange =
        Number(minInput.value || 0) <= Number(minThumb.min) &&
        Number(maxInput.value || maxThumb.max) >= Number(maxThumb.max)
      if (atDefaultRange) {
        params.delete(minInput.name)
        params.delete(maxInput.name)
      }
    }

    for (const [key, value] of [...params]) {
      if (value === '') params.delete(key)
    }
    const query = params.toString()
    const url = query ? `${window.location.pathname}?${query}` : window.location.pathname
    this.#fetchAndRender(url)
  }

  async #fetchAndRender(url, pushHistory = true) {
    this.#grid?.classList.add('is-loading')
    const separator = url.includes('?') ? '&' : '?'

    // The panel swap below replaces every <details> wholesale, so any group
    // the shopper had manually expanded (that isn't also "active", which is
    // the only thing the freshly-rendered HTML knows to open) would otherwise
    // silently collapse on every filter change.
    const openParams = new Set(
      Array.from(this.querySelectorAll('[data-filters-panel] details[open]')).map((details) => details.dataset.filterParam)
    )

    try {
      const response = await fetch(`${url}${separator}section_id=${this.#sectionId}`)
      const text = await response.text()
      const doc = new DOMParser().parseFromString(text, 'text/html')

      const newGrid = doc.querySelector('[data-grid-container]')
      if (newGrid && this.#grid) {
        this.#grid.innerHTML = newGrid.innerHTML
        // Product cards render Judge.me's preview badge. Its markup is
        // server-rendered, but re-run Judge.me's badge styling on the freshly
        // swapped-in DOM when its script exposes the hook.
        // Judge.me only styles the rating badges that existed when its script ran,
        // so ask it to render the ones just added (the call differs by version, and
        // the script can still be busy, so run it again a moment later).
        const refreshReviewBadges = () => {
          for (const name of ['batchRenderBadges', 'customizeBadges']) window.jdgm?.[name]?.()
        }
        refreshReviewBadges()
        setTimeout(refreshReviewBadges, 400)
      }

      const newCount = doc.querySelector('[data-product-count]')
      if (newCount && this.#count) this.#count.innerHTML = newCount.innerHTML

      const newFiltersPanel = doc.querySelector('[data-filters-panel]')
      if (newFiltersPanel && this.#filtersPanel) {
        this.#filtersPanel.innerHTML = newFiltersPanel.innerHTML
        for (const details of this.#filtersPanel.querySelectorAll('details[data-filter-param]')) {
          if (openParams.has(details.dataset.filterParam)) details.open = true
        }
      }

      if (pushHistory) history.pushState({}, '', url)
    } finally {
      this.#grid?.classList.remove('is-loading')
    }
  }
}

customElements.define('collection-filters', CollectionFilters)
customElements.define('price-range-slider', PriceRangeSlider)
customElements.define('collection-results', CollectionResults)
{% endjavascript %}

{% schema %}
{
  "name": "Collection product grid",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop, 1200px+)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile, under 768px)",
      "default": "2",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "paragraph",
      "content": "Tablet widths (768–1199px) always show 3 columns."
    },
