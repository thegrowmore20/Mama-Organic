<footer class="footer">
  <div
    class="footer__top"
    {% if section.settings.background_image %}
    style="background-image: url({{ section.settings.background_image | image_url: width: 1920 }});"
    {% endif %}>
    <div class="u-grid container footer__inner">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo">
          {%- if section.settings.logo -%}
            {%- assign logo_h = 175 | divided_by: section.settings.logo.aspect_ratio | round -%}
            {{ section.settings.logo | image_url: width: 175 | image_tag: loading: 'lazy', widths: '175, 262, 350', width: 175, height: logo_h, alt: shop.name }}
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {% if section.settings.footer_brand_content != blank %}
          <div class="footer-brand-text">
            {{ section.settings.footer_brand_content }}
          </div>
        {% endif %}

        {% render 'social-icons', class: 'footer__social-icons' %}
      </div>

      <div class="footer__col footer__col--pages">
        {% if section.settings.pages_heading != blank %}
          <h2 class="footer__col-title">{{ section.settings.pages_heading | escape }}</h2>
        {% endif %}
        <ul class="footer__links">
          {%- for link in section.settings.pages_menu.links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {%- else -%}
            <li>
              <a href="{{ routes.root_url }}">Home</a>
            </li>
            <li>
              <a href="{{ routes.all_products_collection_url }}">Shop</a>
            </li>
            <li>
              <a href="{{ routes.root_url }}">Shop Bundles</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer__col footer__col--policies">
        {% if section.settings.policies_heading != blank %}
          <h2 class="footer__col-title">{{ section.settings.policies_heading | escape }}</h2>
        {% endif %}
        <ul class="footer__links">
          {%- for link in section.settings.help_menu.links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {%- else -%}
            <li>
              <a href="{{ routes.root_url }}policies/privacy-policy">Privacy Policy</a>
            </li>
            <li>
              <a href="{{ routes.root_url }}policies/refund-policy">Return policy</a>
            </li>
            <li>
              <a href="{{ routes.root_url }}policies/shipping-policy">Shipping Policy</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer__col footer__col--contact">
        {%- for block in section.blocks -%}
          {%- if block.type == 'contact' -%}
            <div class="footer__contact" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__col-title">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
                <a href="{{ block.settings.link_url }}" class="footer__contact-item">
                  <span class="footer__contact-icon" aria-hidden="true">{% render 'icon', name: 'open-link' %}</span>
                  <span>{{ block.settings.link_label | escape }}</span>
                </a>
              {%- endif -%}
              {%- if block.settings.phone != blank -%}
                <a href="tel:{{ block.settings.phone | remove: ' ' | escape }}" class="footer__contact-item">
                  <span class="footer__contact-icon" aria-hidden="true">{% render 'icon', name: 'phone' %}</span>
                  <span>
                    {%- if block.settings.phone_label != blank -%}<strong>{{ block.settings.phone_label | escape }}</strong> {% endif -%}
                    {{ block.settings.phone | escape }}
                  </span>
                </a>
              {%- endif -%}
              {%- if block.settings.email != blank -%}
                <a href="mailto:{{ block.settings.email | escape }}" class="footer__contact-item">
                  <span class="footer__contact-icon" aria-hidden="true">{% render 'icon', name: 'mail' %}</span>
                  <span>{{ block.settings.email | escape }}</span>
                </a>
              {%- endif -%}
              {%- if block.settings.address != blank -%}
                {%- if block.settings.address_link != blank -%}
                  <a href="{{ block.settings.address_link }}" class="footer__contact-item footer__contact-item--address" target="_blank" rel="noopener noreferrer">
                    <span class="footer__contact-icon" aria-hidden="true">{% render 'icon', name: 'marker-pin' %}</span>
                    <span>{{ block.settings.address | escape | newline_to_br }}<span class="visually-hidden"> {{ 'general.accessibility.opens_in_new_tab' | t }}</span></span>
                  </a>
                {%- else -%}
                  <p class="footer__contact-item footer__contact-item--address">
                    <span class="footer__contact-icon" aria-hidden="true">{% render 'icon', name: 'marker-pin' %}</span>
                    <span>{{ block.settings.address | escape | newline_to_br }}</span>
                  </p>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

      <p class="footer__newsletter-title">Subscribe newsletter</p>
      {%- comment -%}
        Shopify's `form` tag auto-applies class="contact-form" when no
        class is given - which collided with sections/contact.liquid's own
        .contact-form styling (border/padding/radius) once that section
        existed, since Shopify bundles all section CSS theme-wide. Passing
        an explicit class avoids the collision.
      {%- endcomment -%}
      {%- form 'customer'
        , id: 'FooterNewsletterForm'
        , class: 'footer__newsletter' -%}
        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter">
        <div class="u-flex footer__newsletter-form">
          <label class="visually-hidden" for="FooterNewsletterEmail">Email address</label>
          <input
            type="email"
            id="FooterNewsletterEmail"
            name="contact[email]"
            placeholder="Type your email"
            autocomplete="email"
            required>
          <button type="submit">Subscribe</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="footer__newsletter-message footer__newsletter-message--success" role="status">{{ 'newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          {%- assign newsletter_error = form.errors.messages['email'] | default: form.errors.messages['form'] -%}
          <p class="footer__newsletter-message footer__newsletter-message--error" role="alert">
            {%- if newsletter_error -%}
              {{ newsletter_error }}
            {%- else -%}
              {{ 'newsletter.error' | t }}
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endform -%}
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__bottom-inner">
    <p class="footer__copyright">
    &copy; {{ 'now' | date: '%Y' }}
    <a href="{{ routes.root_url }}" class="footer__brand-link footer__underline">{{ shop.name }}</a>
    All Rights Reserved | Developed by
    <a
      href="http://thegrowmore.com/"
      target="_blank"
      rel="noopener noreferrer"
      class="u-inline-flex u-items-center footer__credit">
      <span class="footer__underline">GrowMore</span>
      {% render 'icon'
        , name: 'open-link' %}
    </a>
    </p>
    {%- if section.settings.bottom_menu != blank and section.settings.bottom_menu.links.size > 0 -%}
      <nav class="footer__bottom-links" aria-label="{{ 'general.accessibility.footer_bottom_menu' | t }}">
        <ul class="u-flex footer__bottom-list" role="list">
          {%- for link in section.settings.bottom_menu.links -%}
            <li>
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %} class="footer__underline">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer__top {
    padding-block: 48px;
    background-color: var(--color-surface);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .footer__inner {
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  /* Phones: brand and contact span the full width; Menu 1 and Menu 2 sit
     side by side, half each. */
  .footer__brand,
  .footer__col--contact {
    grid-column: 1 / -1;
  }

  .footer-brand-text {
    font-size: 14px;
    max-width: 340px;
  }

  @media screen and (min-width: 601px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .footer__col--contact {
      grid-column: auto;
    }
  }

  @media screen and (min-width: 992px) {
    .footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
      gap: 40px;
    }

    .footer__brand {
      grid-column: auto;
    }
  }

  /* Contact column: link, email and address rows with a small leading icon,
     then the newsletter form below them. */
  .footer__contact {
    margin-bottom: var(--space-5);
  }

  .footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    font-size: 14px;
    line-height: 1.5;
  }

  .footer__contact-icon {
    display: flex;
    flex: 0 0 auto;
    margin-top: 3px;
  }

  .footer__contact-icon svg {
    width: 16px;
    height: 16px;
  }

  .footer__social-icons {
    margin-bottom: var(--space-5);
  }

  .footer__logo img {
    height: 90px;
    width: auto;
    object-fit: contain;
    margin-bottom: var(--space-4);
  }

  .footer__logo-text {
    display: inline-block;
    font-size: 22px;
    font-weight: 600;
    font-family: var(--font-accent);
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  .footer__newsletter-title {
    font-size: 18px;
    margin: 0 0 14px;
    font-weight: 500;
    font-family: var(--font-heading);
  }

  .footer__newsletter-form {
    max-width: 340px;
    border-radius: var(--radius-m);
    overflow: hidden;
  }

  .footer__newsletter-form input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-secondary);
    background: #fff;
    padding: var(--space-3) 14px;
    font-size: 14px;
    font-family: var(--font-body);
    border-top-left-radius: var(--radius-m);
    border-bottom-left-radius: var(--radius-m);
  }

  .footer__newsletter-form button {
    background: var(--color-secondary-a11y, var(--color-secondary));
    color: #fff;
    border: none;
    padding: var(--space-3) var(--space-5);
    font-size: 14px;
    cursor: pointer;
  }

  .footer__newsletter-message {
    margin: 10px 0 0;
    font-size: 13px;
  }

  .footer__newsletter-message--success {
    color: #1a7a3c;
  }

  .footer__newsletter-message--error {
    color: #c0392b;
  }

  .footer__col-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 17px;
    margin: 0 0 var(--space-4);
  }

  .footer__links li {
    margin-bottom: 10px;
    font-size: 14px;
  }

  .footer__links a {
    text-decoration: none;
  }

  .footer__bottom {
    background: var(--color-secondary-a11y, var(--color-secondary));
    color: #fff;
    text-align: center;
    font-size: 13px;
    padding: 14px var(--space-5);
  }

  .footer__bottom a {
    color: inherit;
  }

  /* One centred row on desktop: copyright, then the menu links. On phones the
     row stacks and the links come first (order), then the copyright. */
  .footer__bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .footer__copyright {
    margin: 0;
    order: 2;
  }

  .footer__bottom-links {
    order: 1;
  }

  .footer__bottom-list {
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .footer__bottom-inner {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: var(--space-5);
    }

    .footer__copyright {
      order: 1;
    }

    .footer__bottom-links {
      order: 2;
    }
  }

  .footer .footer__bottom a:hover {


    /*
   Higher specificity than the global a:hover teal, which is invisible
   against this section's own teal background. Hover feedback is the
   animated underline below instead (.footer__underline), so no native
   underline here - it would draw over the animation.
*/
    color: inherit;
  }

  .footer__credit {
    gap: var(--space-1);
  }


  /*
   Hover underline that draws in from the start of the text to the end.
   A 1px currentColor gradient is grown from 0% to 100% width (only
   background-size is transitioned): at rest it is parked on the right edge,
   and on hover it snaps to the left edge - while still 0 wide, so
   invisible - and then grows rightwards; on leave it snaps back to the right
   edge while full width and shrinks away, so it wipes out in the same
   direction it was drawn. inline-block so the box (and so the underline)
   hugs the text; used on the shop name, the bottom bar menu links and the GrowMore
   text only, not the icon beside it.
*/
  .footer__underline {
    display: inline-block;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 0 1px;
    background-position: 100% 100%;
    transition: background-size 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* GrowMore is underlined at rest. The resting line is a softer one
     (currentColor at 55%) so the hover sweep has something to visibly draw
     over: the first gradient layer is the same animated full-strength line
     as above, the second is the static resting line, both on the bottom edge. */
  .footer__credit .footer__underline {
    background-image:
      linear-gradient(currentColor, currentColor),
      linear-gradient(color-mix(in srgb, currentColor 55%, transparent), color-mix(in srgb, currentColor 55%, transparent));
    background-size: 0 1px, 100% 1px;
    background-position: 100% 100%, 0 100%;
  }

  .footer__credit svg {
    transition: transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__brand-link:hover,
    .footer__bottom-list a:hover {
      background-size: 100% 1px;
      background-position: 0 100%;
    }

    .footer__credit:hover .footer__underline {
      background-size: 100% 1px, 100% 1px;
      background-position: 0 100%, 0 100%;
    }

    .footer__credit:hover svg {
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__underline,
    .footer__credit svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "richtext",
        "id": "footer_brand_content",
        "label": "Brand Content"
      },
      {
        "type": "text",
        "id": "pages_heading",
        "label": "Menu 1 heading",
        "default": "Pages"
      },
      {
        "type": "text",
        "id": "policies_heading",
        "label": "Menu 2 heading",
        "default": "Policies"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      }, {
        "type": "image_picker",
        "id": "background_image",
        "label": "Top background image (optional)"
      }, {
        "type": "link_list",
        "id": "pages_menu",
        "label": "Menu 1"
      }, {
        "type": "link_list",
        "id": "help_menu",
        "label": "Menu 2"
      }, {
        "type": "link_list",
        "id": "bottom_menu",
        "label": "Copyright Bar Menu",
        "info": "Links shown next to the copyright, for example Terms of Service and Privacy Policy. Leave empty to hide."
      }
    ],
    "blocks": [
      {
        "type": "contact",
        "name": "Contact",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Contact"
          },
          {
            "type": "text",
            "id": "link_label",
            "label": "Contact link text",
            "default": "Get in touch"
          },
          {
            "type": "url",
            "id": "link_url",
            "label": "Contact link",
            "info": "The link shows when both its text and link are set."
          },
          {
            "type": "text",
            "id": "phone_label",
            "label": "Phone label",
            "default": "Call/WhatsApp:"
          },
          {
            "type": "text",
            "id": "phone",
            "label": "Phone number",
            "info": "Shown below the contact link and above the email. Tapping it starts a call."
          },
          {
            "type": "text",
            "id": "email",
            "label": "Email"
          },
          {
            "type": "textarea",
            "id": "address",
            "label": "Address",
            "info": "Line breaks are kept."
          },
          {
            "type": "url",
            "id": "address_link",
            "label": "Address link",
            "info": "Optional - makes the address open in a new tab, e.g. a Google Maps link."
          }
        ]
      }
    ]
  }
{% endschema %}