{%- comment -%}
  Vision / Mission statements: a card per block with an icon, a label and the statement.
  Hides when it has no blocks.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section
    class="about-statements section-padding"
    style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="container">
      {% render 'section-header', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}

      <div class="about-statements__grid">
        {%- for block in section.blocks -%}
          <article class="about-statements__card" {{ block.shopify_attributes }}>
            <span class="about-statements__icon" aria-hidden="true">{% render 'icon', name: block.settings.icon %}</span>
            {%- if block.settings.label != blank -%}
              <h3 class="about-statements__label h4">{{ block.settings.label | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="about-statements__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
.about-statements__grid {
  display: grid;
  gap: var(--space-5);
  margin-top: var(--space-7);
}

.about-statements__grid:first-child {
  margin-top: 0;
}

.about-statements__card {
  padding: var(--space-6) var(--space-5);
  color: var(--color-background);
  background: var(--color-primary);
  border-radius: var(--radius-m);
}

.about-statements__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  margin-bottom: var(--space-4);
  color: var(--color-primary);
  background: var(--color-surface);
  border-radius: 50%;
}

.about-statements__icon svg {
  width: 26px;
  height: 26px;
}

.about-statements__label {
  margin: 0;
  color: var(--color-background);
}

.about-statements__text {
  margin: var(--space-3) 0 0;
  font-size: 18px;
  line-height: 1.6;
  color: var(--color-background);
}

@media screen and (min-width: 750px) {
  .about-statements__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .about-statements__card {
    padding: var(--space-7) var(--space-6);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "About statements",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Mission" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where We Are Headed" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "statement",
      "name": "Statement",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sun", "label": "Sun" },
            { "value": "target", "label": "Target" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "target"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Our Mission" },
        { "type": "textarea", "id": "text", "label": "Statement" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About statements",
      "blocks": [
        {
          "type": "statement",
          "settings": {
            "icon": "sun",
            "label": "Our Vision",
            "text": "We are committed to building eco-friendly products that enhance the natural beauty of skin and hair around the world."
          }
        },
        {
          "type": "statement",
          "settings": {
            "icon": "target",
            "label": "Our Mission",
            "text": "To build natural and toxin-free products for skin, hair and body, for everyone and everywhere."
          }
        }
      ]
    }
  ]
}
{% endschema %}
