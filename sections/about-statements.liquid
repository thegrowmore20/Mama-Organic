{%- comment -%}
  Our Mission: centred header, one white card per vision/mission (icon, label, heading, text),
  and a dark "promise" bar with a headline and badge pills that joins the next section.
  Every part hides when empty. No JavaScript.
{%- endcomment -%}

{%- liquid
  assign card_count = 0
  assign badge_count = 0
  for block in section.blocks
    if block.type == 'card'
      assign card_count = card_count | plus: 1
    elsif block.type == 'badge'
      assign badge_count = badge_count | plus: 1
    endif
  endfor
  assign cards_per_row = card_count | at_most: 3 | at_least: 1
  assign show_promise = false
  if section.settings.show_promise
    if section.settings.promise_heading != blank or badge_count > 0
      assign show_promise = true
    endif
  endif
-%}

{%- if card_count > 0 or section.settings.heading != blank -%}
  <section
    class="about-mission section-padding"
    style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --cards: {{ cards_per_row }};"
  >
    {%- if section.settings.show_leaves -%}
      <svg class="about-mission__leaf about-mission__leaf--top" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><path d="M100 10C40 40 20 110 60 160c40 50 110 30 130-30C170 70 140 30 100 10z"/></svg>
      <svg class="about-mission__leaf about-mission__leaf--bottom" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><path d="M100 10C40 40 20 110 60 160c40 50 110 30 130-30C170 70 140 30 100 10z"/></svg>
    {%- endif -%}

    <div class="container about-mission__container">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        text: section.settings.text
      %}

      {%- if card_count > 0 -%}
        <div class="about-mission__cards u-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'card' -%}
              <article class="about-mission__card" {{ block.shopify_attributes }}>
                <span class="about-mission__icon u-inline-flex u-items-center u-justify-center" aria-hidden="true">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '28px', alt: '' }}
                  {%- else -%}
                    {% render 'icon', name: block.settings.icon %}
                  {%- endif -%}
                </span>
                {%- if block.settings.label != blank -%}
                  <p class="about-mission__label">{{ block.settings.label | escape }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="about-mission__title h4">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="about-mission__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if show_promise -%}
        <div class="about-mission__promise u-flex u-justify-between">
          {%- if section.settings.promise_heading != blank -%}
            <p class="about-mission__promise-text">{{ section.settings.promise_heading | escape }}</p>
          {%- endif -%}
          {%- if badge_count > 0 -%}
            <ul class="about-mission__badges u-flex" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'badge' -%}
                  <li class="about-mission__badge" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
.about-mission {
  position: relative;
  overflow: hidden;
  background: var(--color-surface);
}

.about-mission__leaf {
  display: none;
  position: absolute;
  fill: var(--color-secondary);
  opacity: 0.12;
  pointer-events: none;
}

.about-mission__container {
  position: relative;
}

.about-mission__cards {
  gap: var(--space-5);
  margin-top: var(--space-7);
}

.about-mission__card {
  padding: var(--space-6) var(--space-5);
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: 22px;
  box-shadow: 0 18px 44px rgba(0, 46, 37, 0.09);
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.about-mission__icon {
  width: 58px;
  height: 58px;
  margin-bottom: var(--space-4);
  color: var(--color-primary);
  background: var(--color-surface);
  border-radius: 50%;
}

.about-mission__icon svg,
.about-mission__icon img {
  width: 28px;
  height: 28px;
  object-fit: contain;
}

.about-mission__label {
  margin: 0 0 var(--space-1);
  font-family: var(--font-accent);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-secondary-a11y, var(--color-secondary));
}

.about-mission__title {
  margin: 0 0 var(--space-3);
  color: var(--color-dark);
}

.about-mission__text {
  line-height: 1.8;
  color: var(--color-text-muted);
}

.about-mission__text > :first-child {
  margin-top: 0;
}

.about-mission__text > :last-child {
  margin-bottom: 0;
}

.about-mission__promise {
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-4);
  margin-top: var(--space-7);
  padding: var(--space-5);
  color: var(--color-background);
  background: var(--color-dark);
  border-radius: 18px 18px 0 0;
}

.about-mission__promise-text {
  margin: 0;
  font-family: var(--font-heading);
  font-size: clamp(17px, 2vw, 22px);
  font-weight: 600;
  line-height: 1.5;
}

.about-mission__badges {
  flex-wrap: wrap;
  gap: var(--space-2);
  margin: 0;
  padding: 0;
  list-style: none;
}

.about-mission__badge {
  padding: 9px 16px;
  font-size: 12.5px;
  letter-spacing: 0.06em;
  white-space: nowrap;
  color: var(--color-background);
  border: 1px solid var(--color-background);
  border-radius: 999px;
}

@media screen and (prefers-reduced-motion: no-preference) {
  .about-mission__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 60px rgba(0, 46, 37, 0.14);
  }
}

@media screen and (min-width: 600px) {
  .about-mission__leaf {
    display: block;
  }

  .about-mission__leaf--top {
    top: -60px;
    left: -70px;
    width: 280px;
    transform: rotate(18deg);
  }

  .about-mission__leaf--bottom {
    right: -60px;
    bottom: 120px;
    width: 240px;
    transform: rotate(-24deg);
  }
}

@media screen and (min-width: 750px) {
  .about-mission__cards {
    grid-template-columns: repeat(min(var(--cards), 2), minmax(0, 1fr));
    gap: 26px;
  }

  .about-mission__card {
    padding: var(--space-7) var(--space-6);
  }

  .about-mission__promise {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: var(--space-6) var(--space-7);
    border-radius: 22px 22px 0 0;
  }
}

@media screen and (min-width: 990px) {
  .about-mission__cards {
    grid-template-columns: repeat(var(--cards), minmax(0, 1fr));
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "About mission",
  "class": "section",
  "max_blocks": 7,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Mission" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where we are headed" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro",
      "default": "<p>A clear direction for the brand, and a clear promise to the people who use our products every day.</p>"
    },
    { "type": "checkbox", "id": "show_leaves", "label": "Show decorative leaves", "default": true },
    { "type": "header", "content": "Promise bar" },
    { "type": "checkbox", "id": "show_promise", "label": "Show promise bar", "default": true },
    { "type": "text", "id": "promise_heading", "label": "Headline", "default": "Natural source ingredients. No harsh chemicals. Fair prices." },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon image", "info": "Optional. Replaces the built-in icon below." },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "options": [
            { "value": "globe", "label": "Globe" },
            { "value": "marker-pin", "label": "Location pin" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "drop", "label": "Drop" },
            { "value": "sun", "label": "Sun" },
            { "value": "target", "label": "Target" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "globe"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Our Vision" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Eco-friendly beauty, around the world" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "100% Natural" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About mission",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "globe",
            "label": "Our Vision",
            "heading": "Eco-friendly beauty, around the world",
            "text": "<p>We are committed to building eco-friendly products that enhance the natural beauty of skin and hair around the world.</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "marker-pin",
            "label": "Our Mission",
            "heading": "Toxin-free care, for everyone",
            "text": "<p>To build natural and toxin-free products for skin, hair and body, for everyone, everywhere.</p>"
          }
        },
        { "type": "badge", "settings": { "label": "100% Natural" } },
        { "type": "badge", "settings": { "label": "Toxin Free" } },
        { "type": "badge", "settings": { "label": "Doorstep Delivery" } }
      ]
    }
  ]
}
{% endschema %}
